---
import Layout from '../layouts/Layout.astro';
import CadavreExquis from '../components/CadavreExquis.astro';
import GoldenThread from '../components/GoldenThread.astro';
import PortraitSketch from '../components/PortraitSketch.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');
---

<Layout title="arsomnia" lang="en">
	<GoldenThread />
	<!-- Hero Section -->
	<section id="inicio" class="hero">
		<div class="hero-layout">
			<div class="hero-content" id="hero-content">
			<h1 class="hero-title" id="hero-title" set:html={t('hero.title')}>
			</h1>
			<p class="hero-subtitle" id="hero-subtitle" set:html={t('hero.subtitle')}>
			</p>
			<div class="hero-buttons">
				<a href="#proyectos" class="btn btn-primary">
					{t('hero.cta_primary')}
					<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
						<path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					</svg>
				</a>
				<a href="#contacto" class="btn btn-secondary">{t('hero.cta_secondary')}</a>
			</div>
			</div>
			<div class="hero-sketch">
				<CadavreExquis />
			</div>
		</div>
	</section>

	<!-- About Section -->
	<section id="acerca" class="about">
		<div class="container">
			<div class="about-header">
				<figure class="about-portrait">
					<PortraitSketch label="Portrait de Orlando Corcuera" />
				</figure>
				<h2 class="about-headline">{t('about.headline')}</h2>
				<p class="about-subtitle">{t('about.subtitle')}</p>
			</div>

			<div class="about-boxes">
				<div class="about-box">
					<div class="box-header">
						<div class="box-icon">
							<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="16 18 22 12 16 6"></polyline>
								<polyline points="8 6 2 12 8 18"></polyline>
							</svg>
						</div>
						<h3 class="box-title">{t('about.box_1_title')}</h3>
					</div>
					<div class="box-content">
						<p>{t('about.box_1_line1')}</p>
						<p class="box-spacer"></p>
						<p>{t('about.box_1_line3')}</p>
					</div>
				</div>

				<div class="about-box">
					<div class="box-header">
						<div class="box-icon">
							<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<circle cx="12" cy="12" r="2.5" fill="currentColor"></circle>
							</svg>
						</div>
						<h3 class="box-title">{t('about.box_2_title')}</h3>
					</div>
					<div class="box-content">
						<p>{t('about.box_2_line1')}</p>
						<p class="box-spacer"></p>
						<p>{t('about.box_2_line2')}</p>
					</div>
				</div>

				<div class="about-box">
					<div class="box-header">
						<div class="box-icon">
							<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
							</svg>
						</div>
						<h3 class="box-title">{t('about.box_3_title')}</h3>
					</div>
					<div class="box-content">
						<p>{t('about.box_3_line1')}</p>
						<p class="box-spacer"></p>
						<p>{t('about.box_3_line2')}</p>
					</div>
				</div>
			</div>

			<div class="about-what-i-build">
				<h3 class="what-i-build-title">{t('about.what_i_build_title')}</h3>
				<ul class="what-i-build-list">
					<li>{t('about.what_i_build_1')}</li>
					<li>{t('about.what_i_build_2')}</li>
					<li>{t('about.what_i_build_3')}</li>
					<li>{t('about.what_i_build_4')}</li>
				</ul>
			</div>

			<div class="about-meta">
				<p>{t('about.meta')}</p>
			</div>
		</div>
	</section>

	<!-- Transition Banner -->
	<div class="transition-banner">
		<div class="container">
			<p class="transition-text" set:html={t('about.transition_banner')}></p>
		</div>
	</div>

	<!-- Projects Section -->
	<section id="proyectos" class="projects">
		<div class="container">
			<div class="section-header">
				<h2 class="section-title-center">{t('projects.title')}</h2>
				<p class="section-subtitle">
					{t('projects.subtitle')}
				</p>
			</div>

			<!-- Project Filter -->
			<div class="project-filter">
				<button class="filter-btn" data-filter="apps">
					<span>{t('projects.filter_apps')}</span>
				</button>
				<button class="filter-btn" data-filter="websites">
					<span>{t('projects.filter_websites')}</span>
				</button>
			</div>

		<div class="projects-grid">
			<a href="https://vagari.watch/" target="_blank" rel="noopener noreferrer" class="project-card" data-category="apps">
				<div class="project-image" style={`background-image: url('/vagari.jpg');`}>
				</div>
				<div class="project-info">
					<div class="project-header">
						<div>
							<h3 class="project-name">{t('projects.vagari.name')}</h3>
							<p class="project-category">{t('projects.vagari.category')}</p>
						</div>
						<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
							<path d="M5 15L15 5M15 5H8M15 5V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
				</div>
			</a>
			<a href="https://www.elnectar.io/" target="_blank" rel="noopener noreferrer" class="project-card" data-category="websites">
				<div class="project-image" style={`background-image: url('/nectario.png');`}>
				</div>
				<div class="project-info">
					<div class="project-header">
						<div>
							<h3 class="project-name">{t('projects.nectario.name')}</h3>
							<p class="project-category">{t('projects.nectario.category')}</p>
						</div>
						<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
							<path d="M5 15L15 5M15 5H8M15 5V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
				</div>
			</a>
			<a href="https://arsomnia.github.io/buscando-a-hopper/" target="_blank" rel="noopener noreferrer" class="project-card" data-category="websites">
				<div class="project-image" style={`background-image: url('/hopper.png');`}>
				</div>
				<div class="project-info">
					<div class="project-header">
						<div>
							<h3 class="project-name">{t('projects.hopper.name')}</h3>
							<p class="project-category">{t('projects.hopper.category')}</p>
						</div>
						<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
							<path d="M5 15L15 5M15 5H8M15 5V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
						</svg>
					</div>
				</div>
			</a>
		</div>
		</div>
	</section>

	<!-- Contact Section -->
	<section id="contacto" class="contact">
		<div class="container">
			<div class="contact-content">
				<div class="contact-header">
					<h2 class="section-title-center">{t('contact.title')}</h2>
					<p class="section-subtitle">
						{t('contact.subtitle')}
					</p>
				</div>

				<form id="contact-form" class="contact-form" action="https://formspree.io/f/mgvplpyr" method="POST">
					<!-- Honeypot field for spam protection -->
					<input type="text" name="_gotcha" style="display:none" />

					<div class="form-group">
						<label for="name">{t('contact.form.name')}</label>
						<input type="text" id="name" name="name" placeholder={t('contact.form.name_placeholder')} required />
					</div>
					<div class="form-group">
						<label for="email">{t('contact.form.email')}</label>
						<input type="email" id="email" name="email" placeholder={t('contact.form.email_placeholder')} required />
					</div>
					<div class="form-group">
						<label for="profile-type">{t('contact.form.profile_type')}</label>
						<select id="profile-type" name="profile-type" required>
							<option value="">{t('contact.form.profile_type_placeholder')}</option>
							<option value="recruiter">{t('contact.form.profile_type_recruiter')}</option>
							<option value="company">{t('contact.form.profile_type_company')}</option>
							<option value="entrepreneur">{t('contact.form.profile_type_entrepreneur')}</option>
							<option value="agency">{t('contact.form.profile_type_agency')}</option>
							<option value="other">{t('contact.form.profile_type_other')}</option>
						</select>
					</div>
					<div class="form-group">
						<label for="message">{t('contact.form.message')}</label>
						<textarea id="message" name="message" rows="6" placeholder={t('contact.form.message_placeholder')} required></textarea>
					</div>
					<button type="submit" id="contact-submit-btn" class="btn btn-primary btn-full">{t('contact.form.submit')}</button>
					<p class="form-trust-message">{t('contact.form.trust_message')}</p>
				</form>
				<p id="form-status" class="form-status"></p>
			</div>
		</div>
	</section>

	<script>
		// Form Submission Handler
		const form = document.getElementById('contact-form') as HTMLFormElement;
		const statusEl = document.getElementById('form-status');
		const submitBtn = document.getElementById('contact-submit-btn');

		async function handleSubmit(event: Event) {
			event.preventDefault();
			if (!form || !statusEl || !submitBtn) return;

			const formData = new FormData(event.target as HTMLFormElement);
			submitBtn.textContent = 'Envoi en cours...';
			submitBtn.setAttribute('disabled', 'true');
			statusEl.textContent = '';
			statusEl.className = 'form-status';

			try {
				const response = await fetch(form.action, {
					method: form.method,
					body: formData,
					headers: {
						'Accept': 'application/json'
					}
				});

				if (response.ok) {
					statusEl.textContent = "Merci pour votre message ! Je vous répondrai bientôt.";
					statusEl.classList.add('success');
					form.reset();
				} else {
					const data = await response.json();
					statusEl.textContent = data.error || 'Oups ! Un problème est survenu lors de l\'envoi du formulaire.';
					statusEl.classList.add('error');
				}
			} catch (error) {
				statusEl.textContent = 'Oups ! Un problème de réseau est survenu.';
				statusEl.classList.add('error');
			} finally {
				submitBtn.textContent = 'Envoyer le Message';
				submitBtn.removeAttribute('disabled');
			}
		}

		form?.addEventListener('submit', handleSubmit);

		// Project Filter Handler
		const filterButtons = document.querySelectorAll('.filter-btn');
		const projectCards = document.querySelectorAll('.project-card');

		filterButtons.forEach(button => {
			button.addEventListener('click', () => {
				const filter = button.getAttribute('data-filter');
				const isActive = button.classList.contains('active');
				
				if (isActive) {
					// Deselect - show all projects
					button.classList.remove('active');
					projectCards.forEach(card => {
						card.classList.remove('hidden');
					});
				} else {
					// Select - filter projects
					filterButtons.forEach(btn => btn.classList.remove('active'));
					button.classList.add('active');
					
					projectCards.forEach(card => {
						const category = card.getAttribute('data-category');
						
						if (category === filter) {
							card.classList.remove('hidden');
						} else {
							card.classList.add('hidden');
						}
					});
				}
			});
		});
	</script>

	<!-- Footer -->
	<footer class="footer">
		<div class="container">
			<div class="footer-content">
				<p class="footer-text">© 2026 arsomnia</p>
			</div>
		</div>
	</footer>
</Layout>

<style>
.container {
	max-width: 1120px;
	margin: 0 auto;
	padding: 0 clamp(1.5rem, 4vw, 3rem);
}

.hero {
	min-height: calc(100vh - 5.5rem);
	min-height: calc(100svh - 5.5rem);
	display: flex;
	align-items: center;
	padding: 4.5rem 0 5rem;
	position: relative;
}

.hero-layout {
	width: min(1180px, 100%);
	margin: 0 auto;
	padding: 0 clamp(1.5rem, 5vw, 4.5rem);
	display: grid;
	grid-template-columns: minmax(0, 1.05fr) minmax(240px, 0.82fr);
	column-gap: clamp(3rem, 8vw, 7.5rem);
	align-items: center;
}

.hero-content {
	position: relative;
	z-index: 1;
	max-width: 34rem;
}

.hero-title {
	font-size: clamp(3rem, 5.4vw, 4.85rem);
	font-weight: 700;
	line-height: 1.02;
	letter-spacing: -0.03em;
	margin-bottom: 1.75rem;
	color: var(--color-text);
	text-wrap: balance;
}

:global(.hero-title-accent) {
	color: inherit;
	text-decoration: underline;
	text-decoration-color: var(--color-text);
	text-decoration-thickness: 3px;
	text-underline-offset: 0.14em;
	text-decoration-skip-ink: none;
}

.hero-subtitle {
	font-size: 1.15rem;
	color: var(--color-text-light);
	margin-bottom: 2.75rem;
	line-height: 1.7;
	font-weight: 400;
	max-width: 28rem;
}

.hero-sketch {
	position: relative;
	height: min(68vh, 640px);
	min-height: 440px;
	justify-self: stretch;
}

.hero-buttons {
	display: flex;
	gap: 0.85rem 1.25rem;
	justify-content: flex-start;
	align-items: center;
	flex-wrap: wrap;
}

.btn {
	padding: 0.85rem 1.45rem;
	border-radius: 0;
	text-decoration: none;
	font-weight: 500;
	font-size: 0.95rem;
	letter-spacing: 0.02em;
	transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	border: 1px solid var(--color-text);
	cursor: pointer;
	background: transparent;
	color: var(--color-text);
	font-family: var(--font-main);
	line-height: 1.2;
}

.btn-primary {
	background: var(--color-text);
	color: var(--color-bg);
	border-color: var(--color-text);
}

.btn-primary:hover {
	background: transparent;
	color: var(--color-text);
}

.btn-secondary:hover {
	background: var(--color-text);
	color: var(--color-bg);
}

.btn-full {
	width: 100%;
	justify-content: center;
}

.about {
	background: var(--color-bg-secondary);
	padding: 8.5rem 0 7.5rem;
}

.about-header {
	display: flex;
	flex-direction: column;
	align-items: center;
	text-align: center;
	margin-bottom: 5.5rem;
}

.about-portrait {
	width: 196px;
	height: 240px;
	margin: 0 0 2.75rem;
	overflow: hidden;
	border: 1px solid rgba(22, 21, 19, 0.72);
	border-radius: 1px;
	transform: rotate(-1.25deg);
	background: var(--color-bg);
}

.about-portrait img {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
	filter: grayscale(1) contrast(1.08);
}

.about-headline {
	font-size: clamp(2rem, 3.4vw, 2.7rem);
	font-weight: 700;
	line-height: 1.25;
	color: var(--color-text);
	letter-spacing: -0.025em;
	margin-bottom: 1.15rem;
	max-width: 18ch;
	text-wrap: balance;
}

.about-headline::after {
	content: "";
	display: block;
	width: 2.25rem;
	height: 1px;
	margin: 1.35rem auto 0;
	background: var(--color-text);
}

.about-subtitle {
	font-size: 1.08rem;
	color: var(--color-text-light);
	margin: 0;
	line-height: 1.7;
	max-width: 36rem;
}

.about-boxes {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.75rem;
	margin-bottom: 5.5rem;
}

.about-box {
	border: 1px solid rgba(22, 21, 19, 0.18);
	padding: 1.85rem 1.6rem 2rem;
	background: transparent;
	transition: border-color 0.25s ease;
	display: flex;
	flex-direction: column;
}

.about-box:hover {
	border-color: rgba(22, 21, 19, 0.72);
}

.box-header {
	display: flex;
	align-items: center;
	gap: 0.7rem;
	margin-bottom: 1.35rem;
	padding-bottom: 0.9rem;
	border-bottom: 1px solid rgba(22, 21, 19, 0.12);
}

.box-icon {
	color: var(--color-text);
	display: flex;
	align-items: center;
	justify-content: center;
}

.box-icon svg {
	width: 26px;
	height: 26px;
}

.box-title {
	font-size: 1.12rem;
	font-weight: 600;
	color: var(--color-text);
	margin: 0;
	letter-spacing: -0.01em;
}

.box-content {
	color: var(--color-text-light);
	font-size: 1.02rem;
	line-height: 1.65;
}

.box-content p {
	margin: 0;
}

.box-spacer {
	height: 1.15rem;
}

.about-cv-container {
	text-align: center;
	margin-bottom: 6rem;
}

.btn-cv {
	display: inline-flex;
	align-items: center;
	gap: 0.75rem;
}

.about-what-i-build {
	margin: 0 auto 4.5rem;
	max-width: 40rem;
}

.what-i-build-title {
	font-size: 1.55rem;
	font-weight: 600;
	margin-bottom: 2rem;
	color: var(--color-text);
	letter-spacing: -0.02em;
	text-align: center;
}

.what-i-build-list {
	list-style: none;
	padding: 0;
	margin: 0 auto;
	display: flex;
	flex-direction: column;
	gap: 1.35rem;
	width: fit-content;
	max-width: 100%;
}

.what-i-build-list li {
	color: var(--color-text-light);
	font-size: 1.12rem;
	line-height: 1.55;
	display: flex;
	align-items: flex-start;
	gap: 0.9rem;
}

.what-i-build-list li::before {
	content: "";
	width: 1.05rem;
	height: 1px;
	margin-top: 0.72rem;
	background: var(--color-text);
	flex-shrink: 0;
}

.about-meta {
	text-align: center;
	padding-top: 2.5rem;
	border-top: 1px solid rgba(22, 21, 19, 0.14);
	max-width: 40rem;
	margin: 0 auto;
}

.about-meta p {
	color: var(--color-text-light);
	font-size: 0.92rem;
	letter-spacing: 0.01em;
	margin: 0;
}

.section-title {
	font-size: clamp(2rem, 4vw, 3rem);
	font-weight: 700;
	line-height: 1.15;
	letter-spacing: -0.03em;
	margin-bottom: 1.5rem;
	color: var(--color-text);
}

.transition-banner {
	background: transparent;
	padding: 5.75rem 0;
	text-align: center;
	border-top: 1px solid rgba(22, 21, 19, 0.14);
	border-bottom: 1px solid rgba(22, 21, 19, 0.14);
}

.transition-text {
	font-size: clamp(1.45rem, 2.4vw, 1.9rem);
	font-weight: 400;
	color: var(--color-text);
	letter-spacing: 0.01em;
	margin: 0 auto;
	max-width: 28rem;
	line-height: 1.45;
}

.projects {
	padding: 8rem 0 7rem;
	background: var(--color-bg);
}

.section-header {
	text-align: center;
	margin-bottom: 0.5rem;
}

.section-title-center {
	font-size: clamp(2.1rem, 4vw, 3.15rem);
	font-weight: 700;
	margin-bottom: 0.85rem;
	color: var(--color-text);
	letter-spacing: -0.03em;
	text-wrap: balance;
}

.section-title-center::after {
	content: "";
	display: block;
	width: 2.25rem;
	height: 1px;
	margin: 1.15rem auto 0;
	background: var(--color-text);
}

.section-subtitle {
	font-size: 1.05rem;
	color: var(--color-text-light);
	max-width: 34rem;
	margin: 1.35rem auto 0;
	line-height: 1.65;
}

.project-filter {
	display: flex;
	justify-content: center;
	align-items: center;
	flex-wrap: wrap;
	gap: 0.4rem 1.75rem;
	margin: 2.75rem auto 4.25rem;
	border: none;
	background: transparent;
	padding: 0;
	max-width: none;
}

.filter-btn {
	flex: none;
	padding: 0.35rem 0.1rem;
	background: transparent;
	border: none;
	border-radius: 0;
	color: var(--color-text-light);
	font-size: 0.78rem;
	font-weight: 500;
	letter-spacing: 0.14em;
	text-transform: uppercase;
	cursor: pointer;
	font-family: var(--font-main);
	box-shadow: inset 0 -1px 0 transparent;
	transition: color 0.2s ease, box-shadow 0.2s ease;
}

.filter-btn:hover,
.filter-btn.active {
	color: var(--color-text);
	background: transparent;
	box-shadow: inset 0 -1px 0 currentColor;
}

.filter-btn span {
	position: relative;
}

.projects-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 4.25rem 2.25rem;
}

.project-card {
	background: transparent;
	border: none;
	border-radius: 0;
	overflow: visible;
	text-decoration: none;
	color: inherit;
	display: block;
}

.project-card.hidden {
	display: none;
}

.project-image {
	height: 210px;
	background-size: cover;
	background-position: center;
	border: 1px solid rgba(22, 21, 19, 0.7);
	filter: grayscale(1) contrast(1.06);
	transition: transform 0.35s ease;
}

.project-card:hover .project-image {
