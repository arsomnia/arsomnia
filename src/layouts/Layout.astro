---
import LanguageSelector from '../components/LanguageSelector.astro';
import { getLangFromUrl, i18nEnabled, useTranslations } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const {
	title = "arsomnia",
	description = "I design and build portfolios, websites and web apps for artists and creative businesses. Toulouse / remote. English, French, Spanish.",
	lang,
} = Astro.props;
const currentLang = (lang || getLangFromUrl(Astro.url)) as 'es' | 'fr' | 'en';
const t = useTranslations(currentLang);
const homeUrl = currentLang === 'en' ? '/' : `/${currentLang}/`;
---

<!doctype html>
<html lang={currentLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Favicon -->
		<link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon/favicon-96x96.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
	</head>
	<body>
		<nav class="nav">
			<div class="nav-container">
				<a href={homeUrl} class="logo">
					<img src="/arsomnia_logo.png" alt="arsomnia logo" class="logo-icon" />
					<span class="logo-text">arsomnia</span>
				</a>
				
				<button class="menu-toggle" aria-label="Toggle menu">
					<span class="hamburger"></span>
				</button>

			<ul class="nav-links">
				<li><a href={`${homeUrl}#inicio`}>{t('nav.home')}</a></li>
				<li><a href={`${homeUrl}#acerca`}>{t('nav.about')}</a></li>
				<li><a href={`${homeUrl}#proyectos`}>{t('nav.projects')}</a></li>
				<li><a href={`${homeUrl}#contacto`}>{t('nav.contact')}</a></li>
			</ul>
			{i18nEnabled && <LanguageSelector currentLang={currentLang} />}
			</div>
		</nav>
		
		<main>
			<slot />
		</main>

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const menuToggle = document.querySelector('.menu-toggle');
				const navLinks = document.querySelector('.nav-links');
				const nav = document.querySelector('.nav');

				menuToggle?.addEventListener('click', () => {
					menuToggle.classList.toggle('active');
					navLinks?.classList.toggle('active');
					nav?.classList.toggle('menu-open');
				});

				// Close menu when clicking on a link
				const links = document.querySelectorAll('.nav-links a');
				links.forEach(link => {
					link.addEventListener('click', () => {
						menuToggle?.classList.remove('active');
						navLinks?.classList.remove('active');
						nav?.classList.remove('menu-open');
					});
				});

				// Close menu when clicking outside
				document.addEventListener('click', (e) => {
					const target = e.target as HTMLElement;
					if (!target.closest('.nav-container')) {
						menuToggle?.classList.remove('active');
						navLinks?.classList.remove('active');
						nav?.classList.remove('menu-open');
					}
				});

				// Active link on scroll
				const sections = document.querySelectorAll('section[id]');
				const navLi = document.querySelectorAll('.nav-links li a');

				if (sections.length > 0) {
					const observer = new IntersectionObserver((entries) => {
						entries.forEach(entry => {
							if (entry.isIntersecting) {
								navLi.forEach(link => {
									link.classList.remove('active');
									const href = link.getAttribute('href');
									if (href && href.includes('#')) {
										const hash = href.split('#')[1];
										if (hash === entry.target.id) {
											link.classList.add('active');
										}
									}
								});
							}
						});
					}, {
						rootMargin: '-50% 0px -50% 0px',
						threshold: 0
					});

					sections.forEach(section => {
						observer.observe(section);
					});
				}
			});
		</script>
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	:root {
		--color-bg: #F3F0E8;
		--color-bg-secondary: #E7E1D6;
		--color-text: #161513;
		--color-text-light: #5C564C;
		--color-accent: #161513;
		--color-accent-secondary: #F7F4EE;
		--color-white: #F7F4EE;
		--font-main: -apple-system, BlinkMacSystemFont, "Segoe UI", "SF Pro Display", Roboto, "Helvetica Neue", Arial, sans-serif;
		--font-display: ui-serif, "New York", Georgia, "Times New Roman", serif;
	}

	html {
		scroll-behavior: smooth;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background-color: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-main);
		line-height: 1.6;
		line-height: 1.65;
		-webkit-font-smoothing: antialiased;
	}

	body::before {
		content: "";
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 4000;
		opacity: 0.55;
		background-image: url("/paper-grain.png");
		background-size: 180px 180px;
	}

	::selection {
		background: var(--color-text);
		color: var(--color-bg);
	}

	img {
		filter: grayscale(1) contrast(1.04);
	}

	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		background: rgba(243, 240, 232, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid rgba(22, 21, 19, 0.12);
		z-index: 1000;
		padding: 1.15rem 0;
	}

	.nav-container {
		max-width: 1180px;
		margin: 0 auto;
		padding: 0 clamp(1.5rem, 5vw, 4.5rem);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2rem;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-text);
		text-decoration: none;
		transition: opacity 0.3s ease;
	}

	.logo-text {
		line-height: 1;
	}

	.logo:hover {
		opacity: 0.8;
	}

	.logo-icon {
		height: 38px;
		height: 34px;
		width: auto;
		flex-shrink: 0;
		object-fit: contain;
		display: block;
		filter: brightness(0);
	}

	.logo-text {
		white-space: nowrap;
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		width: 40px;
		height: 40px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		z-index: 1001;
		position: relative;
	}

	.hamburger,
	.hamburger::before,
	.hamburger::after {
		width: 24px;
		height: 2px;
		background: var(--color-text);
		border-radius: 2px;
		transition: all 0.3s ease;
	}

	.hamburger {
		position: relative;
	}

	.hamburger::before,
	.hamburger::after {
		content: '';
		position: absolute;
		left: 0;
	}

	.hamburger::before {
		top: -7px;
	}

	.hamburger::after {
		bottom: -7px;
	}

	.menu-toggle.active .hamburger {
		background: transparent;
	}

	.menu-toggle.active .hamburger::before {
		transform: rotate(45deg);
		top: 0;
	}

	.menu-toggle.active .hamburger::after {
		transform: rotate(-45deg);
		bottom: 0;
	}

	.nav-links {
		display: flex;
		list-style: none;
		gap: 2.5rem;
	}

	.nav-links li {
		margin: 0;
	}

	.nav-links a {
		color: var(--color-text-light);
		text-decoration: none;
		font-size: 1rem;
		transition: color 0.3s ease;
		display: block;
	}

	.nav-links a:hover {
		color: var(--color-accent);
	}

	.nav-links a.active {
		color: var(--color-accent);
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 8px;
		text-decoration-thickness: 2px;
	}

	main {
		margin-top: 80px;
	}

	@media (max-width: 768px) {
		.nav {
			padding: 1rem 0;
		}

		.nav-container {
			padding: 0 1.5rem;
			display: flex;
			flex-direction: row;
			justify-content: flex-start;
			align-items: center;
			gap: 1rem;
		}

		.logo { flex-shrink: 0; order: 1; }

		.logo-text {
			display: none;
		}

		.language-selector { order: 2; margin-left: auto; margin-right: 0.5rem; }

		.menu-toggle { display: flex; flex-shrink: 0; order: 3; margin-left: 0; }
		.menu-toggle { display: flex; flex-shrink: 0; order: 3; margin-left: auto; }

		.nav-container:has(.language-selector) .menu-toggle { margin-left: 0; }
		.nav-links {
			position: fixed;
			top: 64px;
			left: 0;
			right: 0;
			background: rgba(13, 13, 13, 0.98);
			background: rgba(243, 240, 232, 0.98);
			flex-direction: column;
			gap: 0;
			padding: 1rem 0;
			border-bottom: 1px solid rgba(22, 21, 19, 0.12);
			overflow: hidden;
			opacity: 0;
			transition: all 0.3s ease;
			box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
			will-change: max-height, opacity;
		}

		.nav-links.active {
			max-height: 400px;
			opacity: 1;
		}

		.nav-links li {
			width: 100%;
			border-bottom: 1px solid rgba(212, 175, 55, 0.05);
			border-bottom: 1px solid rgba(22, 21, 19, 0.08);
		}

		.nav-links li:last-child {
			border-bottom: none;
		}

		.nav-links a {
			padding: 1rem 1.5rem;
			font-size: 1rem;
			width: 100%;
			transition: all 0.2s ease;
		}

		.nav-links a:hover, .nav-links a.active {
			background: rgba(22, 21, 19, 0.04);
			color: var(--color-accent);
			text-decoration: none;
		}

		main {
			margin-top: 64px;
		}
	}

	@media (max-width: 480px) {
		.nav-container {
			padding: 0 1rem;
		}
	}
</style>
