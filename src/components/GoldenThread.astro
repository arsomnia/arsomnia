---
// El hilo dorado de la página, ligado al scroll (y reversible):
//   1. nace del ojo del cadavre exquis (≈3 s),
//   2. cae serpenteando mientras se baja (los ojos del retrato la siguen),
//   3. al cruzar el lema revienta y salpica manchas de pintura por toda la pantalla, por detrás,
//   4. en contacto las manchas se deshacen en polen, que flota y se aparta del ratón.
---

<canvas id="thread-back" class="thread-canvas thread-back" aria-hidden="true"></canvas>
<canvas id="thread-front" class="thread-canvas thread-front" aria-hidden="true"></canvas>

<style is:global>
	.thread-canvas {
		position: fixed;
		top: 0;
		left: 0;
		pointer-events: none;
	}

	.thread-back {
		width: 100vw;
		height: 100vh;
		height: 100lvh;
		z-index: -1;
	}

	/* La bola vive en un lienzo pequeño que solo se traslada: mover una capa
	   diminuta sale mucho más barato que componer una a pantalla completa. */
	.thread-front {
		width: 0;
		height: 0;
		z-index: 900;
		will-change: transform;
	}

	/* El lienzo de fondo vive detrás del contenido: los fondos opacos de las
	   secciones pasan a una capa todavía más baja para no taparlo. */
	html body {
		background-color: transparent;
	}

	main > section.about.about,
	main > section.contact.contact {
		position: relative;
		background: transparent;
	}

	main > section.about.about::before,
	main > section.contact.contact::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -2;
		background: var(--color-bg-secondary);
	}

	main > section.projects.projects,
	main > footer.footer.footer {
		background: transparent;
	}
</style>

<script>
	import art from '../data/cadavre.json';

	const back = document.getElementById('thread-back') as HTMLCanvasElement | null;
	const front = document.getElementById('thread-front') as HTMLCanvasElement | null;
	const bctx = back?.getContext('2d') ?? null;
	const fctx = front?.getContext('2d') ?? null;

	if (back && front && bctx && fctx) {
		const GOLD = '211, 175, 55'; // el dorado del favicon (#D3AF37)
		const GOLD_DEEP = '168, 134, 34';
		const GOLD_LIGHT = '240, 216, 120';
		const INTRO_START = 1250; // ms: la bola empieza a nacer cuando el dibujo ya casi está
		const INTRO_MS = 1650; // …y termina antes de los 3 s
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const clamp = (v: number, a = 0, b = 1) => Math.max(a, Math.min(b, v));
		const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
		const smooth = (a: number, b: number, v: number) => {
			const t = clamp((v - a) / (b - a || 1));
			return t * t * (3 - 2 * t);
		};
		const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
		const easeOutBack = (t: number) => 1 + 2.4 * Math.pow(t - 1, 3) + 1.4 * Math.pow(t - 1, 2);

		function rng(seed: number) {
			let a = seed >>> 0;
			return () => {
				a = (a + 0x6d2b79f5) | 0;
				let t = Math.imul(a ^ (a >>> 15), 1 | a);
				t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
				return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
			};
		}

		// ---------- geometría de la página ----------
		let vw = 0;
		let vh = 0;
		let dpr = 1;
		let eye = { x: 0, y: 0, r: 8 }; // en coordenadas de documento
		let s1 = 1; // scroll en el que la bola cruza el lema y revienta
		let s2 = 2; // scroll en el que las manchas empiezan a deshacerse
		let qSpan = 1;
		let cx = 0;
		let hubY = 0;
		let ballR = 12;
		let pupils: { el: SVGCircleElement; cx: number; cy: number; ox: number; oy: number; sx: number; sy: number }[] = [];
		let portrait: SVGSVGElement | null = null;
		let portraitBox = { left: 0, top: 0, width: 0, height: 0 }; // en coordenadas de documento
		let frontHalf = 40; // media anchura del lienzo de la bola
		let frontShown = false;

		// Calidad adaptativa: si el equipo no llega, el fondo baja de densidad de
		// píxeles (son formas suaves, apenas se nota) antes que perder fotogramas.
		const LEVELS = [1, 0.75, 0.625];
		let level = 0;
		let bdpr = 1; // densidad del lienzo de fondo
		let thinSoft = false; // último recurso: la mitad de los granos desenfocados

		// ---------- manchas de pintura ----------
		// Al cruzar el lema la bola revienta: salpica gotas que caen por toda la
		// pantalla y se abren en manchas. En contacto las manchas se deshacen en polen.
		type Stain = {
			x: number; y: number; r: number;
			path: Path2D; // la mancha, en coordenadas locales (radio ≈ 1)
			ext: number; // hasta dónde llega la mancha, en radios
			img: HTMLCanvasElement | null; // la mancha ya pintada, para no rellenarla cada fotograma
			color: string; alpha: number;
			arrive: number; // momento de la salpicadura (0…1) en el que cae su gota
			burst: number; // q en el que empieza a deshacerse
			rot: number;
		};
		type Grain = {
			hx: number; hy: number; // el punto de la mancha del que nace
			th: number;
			sx: number; sy: number; // hacia dónde se dispersa
			r: number; a: number; soft: boolean;
			size: number; img: HTMLCanvasElement | null;
			amp: number; f1: number; f2: number; p1: number; p2: number;
			ox: number; oy: number; vx: number; vy: number; // empujón del ratón
		};
		let stains: Stain[] = [];
		let grains: Grain[] = [];
		let netW = 0;
		let netH = 0;
		let splash = 0; // 0 → 1 cuando la bola revienta (con el tiempo, no con el scroll)

		// El grano de polen: un núcleo dorado con un halo suave. Se pinta una vez por
		// tamaño, ya a la densidad del lienzo, para dibujarlo luego casi sin reescalar.
		function makeSprite(stops: [number, string][], px: number) {
			const c = document.createElement('canvas');
			c.width = px;
			c.height = px;
			const g = c.getContext('2d')!;
			const h = px / 2;
			const grad = g.createRadialGradient(h, h, 0, h, h, h);
			for (const [at, color] of stops) grad.addColorStop(at, color);
			g.fillStyle = grad;
			g.fillRect(0, 0, px, px);
			return c;
		}
		const CORE = 0.28; // fracción del sprite que ocupa el núcleo
		const GRAIN_STOPS: [number, string][] = [
			[0, `rgba(${GOLD_DEEP}, 1)`],
			[0.2, `rgba(${GOLD}, 1)`],
			[CORE + 0.04, `rgba(${GOLD}, 0.6)`],
			[0.52, `rgba(${GOLD}, 0.17)`],
			[1, `rgba(${GOLD}, 0)`],
		];
		const SOFT_STOPS: [number, string][] = [
			[0, `rgba(${GOLD}, 0.55)`],
			[0.55, `rgba(${GOLD}, 0.3)`],
			[1, `rgba(${GOLD}, 0)`],
		];
		const GRAIN_SIZES = [6.5, 8.5, 10.5, 13, 15.5, 18.5];
		const SOFT_SIZES = [9, 11.5, 14, 17];

		// (Re)pinta granos y manchas a la densidad actual del lienzo de fondo.
		function buildSprites() {
			const sharp = GRAIN_SIZES.map((size) => makeSprite(GRAIN_STOPS, Math.ceil(size * bdpr)));
			const soft = SOFT_SIZES.map((size) => makeSprite(SOFT_STOPS, Math.ceil(size * bdpr)));
			for (const g of grains) {
				const sizes = g.soft ? SOFT_SIZES : GRAIN_SIZES;
				let k = 0;
				while (k < sizes.length - 1 && sizes[k] < g.size) k++;
				g.img = (g.soft ? soft : sharp)[k];
			}
			for (const s of stains) {
				const px = Math.min(1024, Math.ceil(2 * s.ext * s.r * bdpr));
				const c = document.createElement('canvas');
				c.width = px;
				c.height = px;
				const g = c.getContext('2d')!;
				g.scale(px / (2 * s.ext), px / (2 * s.ext));
				g.translate(s.ext, s.ext);
				g.fillStyle = `rgb(${s.color})`;
				g.fill(s.path);
				s.img = c;
			}
		}

		function buildStains() {
			const rand = rng(20261114);
			const small = vw < 700;
			const TAU = Math.PI * 2;
			const COLORS = [GOLD, GOLD, GOLD_DEEP, GOLD_LIGHT];

			// Una mancha: un borrón irregular, con chorros hacia fuera y gotas sueltas.
			// `dir` es hacia dónde volaba la gota (null = impacto central, en todas direcciones).
			const blot = (dir: number | null, big: boolean) => {
				const path = new Path2D();
				let ext = 1.6;
				const n = 44;
				const h = [2, 3, 4, 5, 7, 9].map((f) => ({ f, a: (rand() * 0.5) / Math.sqrt(f), p: rand() * TAU }));
				const pts: number[] = [];
				for (let i = 0; i < n; i++) {
					const a = (i / n) * TAU;
					let r = 1;
					for (const k of h) r += k.a * 0.36 * Math.sin(a * k.f + k.p);
					if (dir !== null) r *= 1 + 0.22 * Math.cos(a - dir); // estirada en el sentido del vuelo
					pts.push(Math.cos(a) * r, Math.sin(a) * r);
				}
				// curva cerrada y suave por los puntos medios
				path.moveTo((pts[0] + pts[n * 2 - 2]) / 2, (pts[1] + pts[n * 2 - 1]) / 2);
				for (let i = 0; i < n; i++) {
					const j = ((i + 1) % n) * 2;
					path.quadraticCurveTo(pts[i * 2], pts[i * 2 + 1], (pts[i * 2] + pts[j]) / 2, (pts[i * 2 + 1] + pts[j + 1]) / 2);
				}
				path.closePath();

				// chorros: una lengua que se afina y acaba en una gota
				const rays = (big ? 9 : 3) + Math.floor(rand() * (big ? 5 : 4));
				for (let k = 0; k < rays; k++) {
					const a = dir === null ? (k / rays) * TAU + (rand() - 0.5) * 0.5 : dir + (rand() - 0.5) * 2.4;
					const len = 1.25 + Math.pow(rand(), 1.5) * (big ? 1.5 : 1.1);
					const w = 0.07 + rand() * 0.1;
					const ca = Math.cos(a);
					const sa = Math.sin(a);
					// triángulo en el mismo sentido de giro que el borrón y los arcos
					path.moveTo(ca * 0.7 + sa * w, sa * 0.7 - ca * w);
					path.lineTo(ca * len + sa * w * 0.35, sa * len - ca * w * 0.35);
					path.lineTo(ca * len - sa * w * 0.35, sa * len + ca * w * 0.35);
					path.lineTo(ca * 0.7 - sa * w, sa * 0.7 + ca * w);
					path.closePath();
					const br = w * (0.75 + rand() * 0.6);
					ext = Math.max(ext, len + br);
					path.moveTo(ca * len + br, sa * len);
					path.arc(ca * len, sa * len, br, 0, TAU);
				}
				// gotas sueltas alrededor
				const drops = (big ? 16 : 5) + Math.floor(rand() * 6);
				for (let k = 0; k < drops; k++) {
					const a = dir === null ? rand() * TAU : dir + (rand() - 0.5) * 3.4;
					const d = 1.35 + Math.pow(rand(), 1.4) * (big ? 2.2 : 1.5);
					const r = 0.03 + Math.pow(rand(), 2) * 0.13;
					ext = Math.max(ext, d + r);
					path.moveTo(Math.cos(a) * d + r, Math.sin(a) * d);
					path.arc(Math.cos(a) * d, Math.sin(a) * d, r, 0, TAU);
				}
				return { path, ext: ext + 0.04 };
			};

			// la mancha del impacto, en el centro, y las demás repartidas por la pantalla
			const base = Math.min(vw, vh);
			const count = small ? 6 : 10;
			const centers: number[] = [cx, hubY];
			const top = vh * 0.1;
			const bottom = vh * 1.12;
			while (centers.length / 2 < count) {
				let bx = 0;
				let by = 0;
				let bestD = -1;
				for (let t = 0; t < 40; t++) {
					const x = vw * (0.05 + rand() * 0.9);
					const y = top + rand() * (bottom - top);
					let d = Infinity;
					for (let j = 0; j < centers.length; j += 2) d = Math.min(d, Math.hypot(x - centers[j], (y - centers[j + 1]) * 1.15));
					if (d > bestD) {
						bestD = d;
						bx = x;
						by = y;
					}
				}
				centers.push(bx, by);
			}
			let far = 1;
			for (let i = 0; i < centers.length; i += 2) far = Math.max(far, Math.hypot(centers[i] - cx, centers[i + 1] - hubY));

			stains = [];
			for (let i = 0; i < centers.length; i += 2) {
				const x = centers[i];
				const y = centers[i + 1];
				const central = i === 0;
				const d = Math.hypot(x - cx, y - hubY);
				stains.push({
					x, y,
					r: central ? base * (small ? 0.13 : 0.1) : base * (small ? 0.06 + rand() * 0.07 : 0.045 + rand() * 0.075),
					...blot(central ? null : Math.atan2(y - hubY, x - cx), central),
					img: null,
					color: central ? GOLD : COLORS[Math.floor(rand() * COLORS.length)],
					alpha: central ? 0.5 : 0.34 + rand() * 0.2,
					arrive: central ? 0 : 0.12 + 0.4 * (d / far) + rand() * 0.06,
					burst: 0.04 + 0.42 * (1 - d / far) + rand() * 0.08,
					rot: rand() * TAU,
				});
			}

			// Polen: granos que nacen dentro de las manchas (más en las grandes).
			const total = small ? 420 : 950;
			let area = 0;
			for (const s of stains) area += s.r * s.r;
			grains = [];
			for (const s of stains) {
				const n = Math.round((total * s.r * s.r) / area);
				for (let i = 0; i < n; i++) {
					const soft = rand() < 0.13;
					const gr = soft ? 3 + rand() * 4 : 0.8 + Math.pow(rand(), 1.8) * 1.7;
					const a0 = rand() * TAU;
					const d0 = Math.sqrt(rand()) * s.r * 1.1;
					const ang = rand() * TAU;
					const dist = 25 + Math.pow(rand(), 1.6) * 260;
					grains.push({
						hx: s.x + Math.cos(a0) * d0,
						hy: s.y + Math.sin(a0) * d0,
						th: s.burst + rand() * 0.16,
						sx: Math.cos(ang) * dist, sy: Math.sin(ang) * dist,
						r: gr,
						a: soft ? 0.3 + rand() * 0.25 : 0.7 + rand() * 0.3,
						soft,
						size: soft ? gr * 2.4 : (gr * 2) / CORE,
						img: null,
						amp: 10 + rand() * 26,
						f1: 0.14 + rand() * 0.3, f2: 0.3 + rand() * 0.5,
						p1: rand() * TAU, p2: rand() * TAU,
						ox: 0, oy: 0, vx: 0, vy: 0,
					});
				}
			}

			netW = vw;
			netH = vh;
			buildSprites();
		}

		function measure() {
			const newW = window.innerWidth;
			const newH = window.innerHeight;
			vw = newW;
			vh = newH;
			dpr = Math.min(2, window.devicePixelRatio || 1);
			const density = Math.max(1, dpr * LEVELS[level]);
			const respray = density !== bdpr;
			bdpr = density;
			const bw = Math.floor(vw * bdpr);
			const bh = Math.floor(Math.max(vh, back!.clientHeight) * bdpr);
			if (back!.width !== bw || back!.height !== bh) {
				back!.width = bw;
				back!.height = bh;
			}
			const sy = window.scrollY;
			ballR = vw < 700 ? 9.5 : 12.5;
			cx = vw / 2;
			hubY = vh * 0.5;

			const stage = document.getElementById('sketch-stage');
			if (stage) {
				const r = stage.getBoundingClientRect();
				const k = Math.min(r.width / art.w, r.height / art.h);
				eye = {
					x: r.left + (r.width - art.w * k) / 2 + art.eye[0] * k,
					y: r.top + sy + (r.height - art.h * k) / 2 + art.eye[1] * k,
					r: art.eye[2] * k,
				};
			} else {
				eye = { x: vw * 0.7, y: vh * 0.3, r: 8 };
			}

			const projects = document.getElementById('proyectos');
			const contact = document.getElementById('contacto');
			const maxScroll = Math.max(1, document.documentElement.scrollHeight - vh);
			const yp = projects ? projects.getBoundingClientRect().top + sy : maxScroll * 0.6;
			const yc = contact ? contact.getBoundingClientRect().top + sy : maxScroll * 0.9;
			const banner = document.querySelector('.transition-banner');
			const br = banner?.getBoundingClientRect();
			// la bola viaja a media pantalla: revienta justo al terminar de cruzar el lema
			s1 = Math.max(vh * 0.8, br ? br.top + sy + br.height * 0.8 - vh * 0.5 : yp - vh * 0.36);
			s2 = Math.max(s1 + vh * 0.5, Math.min(yc - vh * 0.75, maxScroll - vh * 0.9));
			qSpan = Math.max(120, Math.min(vh * 0.75, maxScroll - 8 - s2));

			// el lienzo de la bola: lo justo para ella, su estela elástica y las gotas del nacimiento
			frontHalf = Math.ceil(Math.max(ballR * 2.2, eye.r * 1.9 + ballR * 1.5) + 6);
			const fpx = Math.floor(frontHalf * 2 * dpr);
			if (front!.width !== fpx) {
				front!.width = fpx;
				front!.height = fpx;
				front!.style.width = front!.style.height = `${frontHalf * 2}px`;
			}

			portrait = document.getElementById('portrait-sketch') as SVGSVGElement | null;
			if (portrait) {
				const r = portrait.getBoundingClientRect();
				portraitBox = { left: r.left, top: r.top + sy, width: r.width, height: r.height };
			}
			if (portrait && !pupils.length) {
				pupils = Array.from(portrait.querySelectorAll<SVGCircleElement>('.portrait-pupil')).map((el) => ({
					el,
					cx: Number(el.getAttribute('cx')),
					cy: Number(el.getAttribute('cy')),
					ox: 0,
					oy: 0,
					sx: 0,
					sy: 0,
				}));
			}

			if (!stains.length || Math.abs(netW - vw) > 2 || Math.abs(netH - vh) > 130) buildStains();
			else if (respray) buildSprites();
			dirty = true;
		}

		// ---------- trayectoria de la bola (función pura del scroll) ----------
		function ballAt(s: number) {
			if (s >= s1) return { x: cx, y: hubY };
			const u = clamp(s / s1);
			const fall = easeInOut(clamp(s / (vh * 0.75)));
			const g = lerp(eye.y / vh, 0.5, fall);
			const env = smooth(0, 0.12, u) * (1 - smooth(0.84, 1, u));
			const amp = Math.min(vw * 0.36, 470);
			// deriva de algo que se hunde: un vaivén amplio y otro pequeño encima
			const meanderX = cx + amp * Math.sin(u * Math.PI * 2 * 2.25 + Math.PI) + vw * 0.03 * Math.sin(u * Math.PI * 2 * 6.3);
			const baseX = lerp(eye.x, cx, smooth(0, 1, u));
			const x = lerp(baseX, meanderX, env);
			const y = g * vh + Math.sin(u * Math.PI * 2 * 3.4) * vh * 0.055 * env;
			return { x, y };
		}

		// ---------- dibujo ----------
		let ss = window.scrollY; // scroll suavizado
		let last = performance.now();
		let start = last;
		let dirty = true;
		let vel = { x: 0, y: 0 };
		let lastPos: { x: number; y: number } | null = null;
		let roll = 0;
		let backWasBusy = false;

		// el ratón (o el dedo) que roza el polen, en coordenadas de pantalla
		const mouse = { x: 0, y: 0, vx: 0, vy: 0, speed: 0, on: false, at: 0 };
		window.addEventListener('pointermove', (e) => {
			const gap = Math.max(8, e.timeStamp - mouse.at) / 1000;
			if (mouse.on && gap < 0.2) {
				const vx = (e.clientX - mouse.x) / gap;
				const vy = (e.clientY - mouse.y) / gap;
				mouse.vx += (vx - mouse.vx) * 0.5;
				mouse.vy += (vy - mouse.vy) * 0.5;
				mouse.speed = Math.min(2400, Math.hypot(mouse.vx, mouse.vy));
			}
			mouse.x = e.clientX;
			mouse.y = e.clientY;
			mouse.at = e.timeStamp;
			mouse.on = true;
		}, { passive: true });
		const mouseOff = () => { mouse.on = false; };
		document.documentElement.addEventListener('pointerleave', mouseOff);
		window.addEventListener('pointercancel', mouseOff);
		window.addEventListener('blur', mouseOff);

		function blob(ctx: CanvasRenderingContext2D, r: number, time: number, wobble: number) {
			const n = 28;
			ctx.beginPath();
			for (let i = 0; i <= n; i++) {
				const a = (i / n) * Math.PI * 2;
				const k = 1 + wobble * (Math.sin(a * 3 + time * 2.1) * 0.6 + Math.sin(a * 5 - time * 3.3) * 0.4);
				const x = Math.cos(a) * r * k;
				const y = Math.sin(a) * r * k;
				if (i === 0) ctx.moveTo(x, y);
				else ctx.lineTo(x, y);
			}
			ctx.closePath();
		}

		function drawBall(ctx: CanvasRenderingContext2D, x: number, y: number, r: number, time: number, wobble: number, alpha = 1) {
			const speed = Math.hypot(vel.x, vel.y);
			const stretch = Math.min(0.32, speed * 0.012);
			ctx.save();
			ctx.translate(x, y);
			ctx.rotate(Math.atan2(vel.y, vel.x || 0.0001));
			ctx.scale(1 + stretch, 1 - stretch * 0.55);
			ctx.rotate(-Math.atan2(vel.y, vel.x || 0.0001));
			blob(ctx, r, time, wobble);
			ctx.fillStyle = `rgba(${GOLD}, ${alpha})`;
			ctx.fill();
			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(${GOLD_DEEP}, ${0.55 * alpha})`;
			ctx.stroke();
			// brillo pequeño que rueda con la bola
			ctx.beginPath();
			ctx.ellipse(Math.cos(roll - 2.2) * r * 0.42, Math.sin(roll - 2.2) * r * 0.42, r * 0.24, r * 0.15, roll, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(${GOLD_LIGHT}, ${0.85 * alpha})`;
			ctx.fill();
			ctx.restore();
		}

		function drawFront(now: number, m: number) {
			const intro = reduceMotion ? 1 : clamp((now - start - INTRO_START) / INTRO_MS);
			const show = m <= 0 && intro > 0;
			if (show !== frontShown) {
				frontShown = show;
				front!.style.visibility = show ? 'visible' : 'hidden';
			}
			if (m > 0) return null;
			const pos = reduceMotion ? { x: eye.x, y: eye.y - window.scrollY } : ballAt(ss);
			if (!show) return pos;

			const time = (now - start) / 1000;
			const h = frontHalf;
			front!.style.transform = `translate3d(${(pos.x - h).toFixed(2)}px, ${(pos.y - h).toFixed(2)}px, 0)`;
			fctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
			fctx!.clearRect(0, 0, h * 2, h * 2);

			const grow = intro < 1 ? Math.max(0, easeOutBack(intro)) : 1;
			const r = ballR * grow;
			const wobble = 0.035 + 0.3 * Math.pow(1 - intro, 1.5);
			if (intro < 1) {
				// gotas doradas que salen del anillo del ojo y se funden en la bola
				const beads = 6;
				for (let i = 0; i < beads; i++) {
					const a = (i / beads) * Math.PI * 2 + intro * 3.2 + i;
					const d = (eye.r * 1.9 + ballR) * Math.pow(1 - intro, 1.6) * (0.7 + 0.3 * Math.sin(i * 2.4));
					const br = ballR * 0.26 * Math.sin(Math.PI * Math.min(1, intro * 1.25));
					if (br <= 0.2) continue;
					fctx!.beginPath();
					fctx!.arc(h + Math.cos(a) * d, h + Math.sin(a) * d, br, 0, Math.PI * 2);
					fctx!.fillStyle = `rgba(${GOLD}, 0.95)`;
					fctx!.fill();
				}
			}
			drawBall(fctx!, h, h, r, time, wobble);
			return pos;
		}

		function drawBack(now: number, m: number, q: number, dt: number) {
			const time = (now - start) / 1000;
			bctx!.setTransform(bdpr, 0, 0, bdpr, 0, 0);
			bctx!.clearRect(0, 0, vw, back!.height / bdpr);
			if (m <= 0) return;

			const par = clamp((ss - s1) / Math.max(1, s2 + qSpan - s1)) * vh * 0.2;
			const fading = q > 0;

			bctx!.save();
			bctx!.translate(0, -par);

			// manchas: primero la gota que vuela desde el impacto, luego el borrón que se abre
			for (const s of stains) {
				const melt = fading ? smooth(0, 0.22, q - s.burst) : 0;
				if (melt >= 1) continue;
				if (m < s.arrive) {
					const t = m / s.arrive;
					const e = 1 - Math.pow(1 - t, 2.2);
					const x = lerp(cx, s.x, e);
					const y = lerp(hubY, s.y, e) - Math.sin(t * Math.PI) * s.r * 0.5;
					bctx!.beginPath();
					bctx!.arc(x, y, Math.max(2, s.r * 0.16), 0, Math.PI * 2);
					bctx!.fillStyle = `rgba(${s.color}, 0.9)`;
					bctx!.fill();
					continue;
				}
				const land = clamp((m - s.arrive) / 0.3);
				const k = Math.max(0, easeOutBack(land)) * (1 - melt * 0.35);
				if (k <= 0.001) continue;
				const half = s.ext * s.r * k;
				bctx!.globalAlpha = s.alpha * (1 - melt);
				bctx!.drawImage(s.img!, s.x - half, s.y - half, half * 2, half * 2);
			}
			bctx!.globalAlpha = 1;

			// polen: cada mancha que se deshace suelta sus granos, que flotan y huyen del ratón
			if (fading) {
				const R = 150;
				const damp = Math.exp(-dt * 1.9);
				const touching = mouse.on;
				const bottom = back!.height / bdpr + par;
				let odd = false;
				for (const g of grains) {
					const rel = q - g.th;
					if (rel <= 0) {
						g.ox = g.oy = g.vx = g.vy = 0;
						continue;
					}
					const free = smooth(0, 0.27, rel);
					const wx = (Math.sin(time * g.f1 + g.p1) + 0.5 * Math.sin(time * g.f2 + g.p2)) * g.amp;
					const wy = (Math.cos(time * g.f1 * 0.83 + g.p2) + 0.5 * Math.sin(time * g.f2 * 1.3 + g.p1)) * g.amp;
					const hold = Math.min(1, free * 3);
					const x = g.hx + free * (g.sx + wx) + g.ox * hold;
					const y = g.hy + free * (g.sy + wy) + g.oy * hold;

					if (touching) {
						const dx = x - mouse.x;
						const dy = y - par - mouse.y;
						const d2 = dx * dx + dy * dy;
						if (d2 < R * R) {
							const d = Math.sqrt(d2) || 1;
							const k = 1 - d / R;
							const push = k * k * (520 + mouse.speed * 1.1) * hold;
							g.vx += ((dx / d) * push + mouse.vx * k * 1.6) * dt;
							g.vy += ((dy / d) * push + mouse.vy * k * 1.6) * dt;
						}
					}
					// solo los granos que el ratón ha movido necesitan física
					if (g.vx !== 0 || g.vy !== 0 || g.ox !== 0 || g.oy !== 0) {
						g.vx = (g.vx - g.ox * 1.1 * dt) * damp;
						g.vy = (g.vy - g.oy * 1.1 * dt) * damp;
						g.ox += g.vx * dt;
						g.oy += g.vy * dt;
						if (Math.abs(g.vx) + Math.abs(g.vy) < 0.05 && Math.abs(g.ox) + Math.abs(g.oy) < 0.05) g.ox = g.oy = g.vx = g.vy = 0;
					}

					if (g.soft && thinSoft && (odd = !odd)) continue;
					const size = g.size;
					if (x < -size || x > vw + size || y < par - size || y > bottom + size) continue; // fuera de pantalla
					const twinkle = 0.82 + 0.18 * Math.sin(time * g.f2 * 2 + g.p1);
					bctx!.globalAlpha = g.a * Math.min(1, rel / 0.04) * twinkle;
					bctx!.drawImage(g.img!, x - size / 2, y - size / 2, size, size);
				}
				bctx!.globalAlpha = 1;
				const calm = Math.exp(-dt * 6);
				mouse.vx *= calm;
				mouse.vy *= calm;
				mouse.speed *= calm;
			}
			bctx!.restore();
		}

		function lookAt(target: { x: number; y: number } | null, dt: number) {
			if (!portrait || !pupils.length) return;
			// la posición del retrato se mide una vez (measure) y aquí solo se le resta el scroll
			const box = portraitBox;
			const top = box.top - window.scrollY;
			if (top + box.height < -200 || top > vh + 200 || box.width < 2) return;
			// viewBox 200×250 con «slice»: la escala es la mayor de las dos
			const k = Math.max(box.width / 200, box.height / 250);
			const ox = box.left + (box.width - 200 * k) / 2;
			const oy = top + (box.height - 250 * k) / 2;
			const ease = 1 - Math.exp(-dt * 10);
			for (const p of pupils) {
				let tx = 0;
				let ty = 0;
				if (target) {
					const dx = target.x - (ox + p.cx * k);
					const dy = target.y - (oy + p.cy * k);
					const d = Math.hypot(dx, dy) || 1;
					const reach = Math.min(1, d / 90);
					tx = (dx / d) * 4.6 * reach;
					ty = (dy / d) * 2.5 * reach;
				}
				p.ox += (tx - p.ox) * ease;
				p.oy += (ty - p.oy) * ease;
				// solo se toca el SVG cuando la pupila se ha movido de verdad
				if (Math.abs(p.ox - p.sx) > 0.01 || Math.abs(p.oy - p.sy) > 0.01) {
					p.sx = p.ox;
					p.sy = p.oy;
					p.el.setAttribute('transform', `translate(${p.ox.toFixed(2)} ${p.oy.toFixed(2)})`);
				}
			}
		}

		// ---------- calidad adaptativa ----------
		let slowFor = 0;
		let fastFor = 0;
		let patience = 6; // segundos fluidos antes de volver a subir la calidad
		function tune(raw: number, animating: boolean) {
			if (!animating || raw > 0.25) return; // en reposo o al volver de otra pestaña no se mide
			if (raw > 0.022) {
				slowFor += raw;
				fastFor = 0;
			} else if (raw < 0.0175) {
				fastFor += raw;
				slowFor = Math.max(0, slowFor - raw);
			}
			if (slowFor > 1) {
				slowFor = 0;
				if (level < LEVELS.length - 1 && dpr * LEVELS[level + 1] >= 1) {
					level++;
					measure();
				} else if (!thinSoft) {
					thinSoft = true;
				}
			} else if (fastFor > patience && (thinSoft || level > 0)) {
				fastFor = 0;
				patience *= 2; // si vuelve a ir justo, cada vez se espera más: nada de vaivenes
				if (thinSoft) thinSoft = false;
				else {
					level--;
					measure();
				}
			}
		}

		function frame(now: number) {
			const raw = (now - last) / 1000;
			const dt = Math.min(0.05, raw);
			last = now;
			const target = window.scrollY;
			const before = ss;
			// El scroll suavizado sigue de cerca los gestos normales, acelera cuando se
			// queda atrás y, ante un salto (enlace del menú, tecla Fin), llega de golpe.
			const gap = Math.abs(target - ss);
			const jumped = gap > vh * 0.6;
			if (jumped) ss = target;
			else ss += (target - ss) * (1 - Math.exp(-dt * (8 + 26 * clamp((gap / vh - 0.12) / 0.4))));
			if (Math.abs(target - ss) < 0.1) ss = target;
			if (ss !== before) dirty = true;

			// La salpicadura es un golpe con su propio tiempo; si ya se ha pasado de
			// largo se apresura, y tras un salto aparece directamente en su estado final.
			const wasSplash = splash;
			if (!reduceMotion) {
				if (jumped) splash = ss >= s1 ? 1 : 0;
				else if (ss >= s1) splash = clamp(splash + (dt / 0.85) * (1 + 3 * clamp((ss - s1) / (vh * 0.8))));
				else splash = clamp(splash - (dt / 0.45) * (1 + 3 * clamp((s1 - ss) / (vh * 0.8))));
			}
			const m = splash;
			const q = reduceMotion ? 0 : clamp((ss - s2) / qSpan);

			const pos = drawFront(now, m);
			const where = pos ?? { x: cx, y: hubY };
			if (lastPos && dt > 0) {
				const k = 1 - Math.exp(-dt * 12);
				// la velocidad propia de la bola, sin contar el desplazamiento de la página
				vel.x += ((where.x - lastPos.x) / (dt * 60) - vel.x) * k;
				vel.y += ((where.y - lastPos.y) / (dt * 60) - vel.y) * k;
				roll += (where.x - lastPos.x) / ballR;
			}
			lastPos = where;

			const busy = m > 0;
			const animating = busy && (q > 0 || splash !== wasSplash);
			tune(raw, animating); // antes de dibujar: si cambia la densidad, este mismo fotograma ya la usa
			if (busy ? dirty || animating : backWasBusy) drawBack(now, m, q, dt);
			backWasBusy = busy;
			dirty = false;

			lookAt(m < 1 ? where : null, dt);
			requestAnimationFrame(frame);
		}

		measure();
		let resizeTimer = 0;
		const remeasure = () => {
			clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(measure, 120);
		};
		window.addEventListener('resize', remeasure);
		window.addEventListener('load', measure);
		new ResizeObserver(remeasure).observe(document.body);
		document.fonts?.ready.then(measure);
		requestAnimationFrame((now) => {
			start = now;
			last = now;
			frame(now);
		});
	}
</script>
