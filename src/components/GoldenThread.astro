---
// El hilo dorado de la página, ligado al scroll (y reversible):
//   1. nace del ojo del cadavre exquis (≈3 s),
//   2. cae serpenteando mientras se baja (los ojos del retrato la siguen),
//   3. en proyectos germina en un micelio que ocupa toda la pantalla, por detrás,
//   4. en contacto el micelio se recoge en «motas».
---

<canvas id="thread-back" class="thread-canvas thread-back" aria-hidden="true"></canvas>
<canvas id="thread-front" class="thread-canvas thread-front" aria-hidden="true"></canvas>

<style is:global>
	.thread-canvas {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		height: 100lvh;
		pointer-events: none;
	}

	.thread-back {
		z-index: -1;
	}

	.thread-front {
		z-index: 900;
	}

	/* El lienzo de fondo vive detrás del contenido: los fondos opacos de las
	   secciones pasan a una capa todavía más baja para no taparlo. */
	html body {
		background-color: transparent;
	}

	main > section.about.about,
	main > section.contact.contact {
		position: relative;
		background: transparent;
	}

	main > section.about.about::before,
	main > section.contact.contact::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -2;
		background: var(--color-bg-secondary);
	}

	main > section.projects.projects,
	main > footer.footer.footer {
		background: transparent;
	}
</style>

<script>
	import art from '../data/cadavre.json';

	const back = document.getElementById('thread-back') as HTMLCanvasElement | null;
	const front = document.getElementById('thread-front') as HTMLCanvasElement | null;
	const bctx = back?.getContext('2d') ?? null;
	const fctx = front?.getContext('2d') ?? null;

	if (back && front && bctx && fctx) {
		const GOLD = '211, 175, 55'; // el dorado del favicon (#D3AF37)
		const GOLD_DEEP = '168, 134, 34';
		const GOLD_LIGHT = '240, 216, 120';
		const INTRO_START = 1250; // ms: la bola empieza a nacer cuando el dibujo ya casi está
		const INTRO_MS = 1650; // …y termina antes de los 3 s
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const clamp = (v: number, a = 0, b = 1) => Math.max(a, Math.min(b, v));
		const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
		const smooth = (a: number, b: number, v: number) => {
			const t = clamp((v - a) / (b - a || 1));
			return t * t * (3 - 2 * t);
		};
		const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
		const easeOutBack = (t: number) => 1 + 2.4 * Math.pow(t - 1, 3) + 1.4 * Math.pow(t - 1, 2);

		function rng(seed: number) {
			let a = seed >>> 0;
			return () => {
				a = (a + 0x6d2b79f5) | 0;
				let t = Math.imul(a ^ (a >>> 15), 1 | a);
				t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
				return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
			};
		}

		// ---------- geometría de la página ----------
		let vw = 0;
		let vh = 0;
		let dpr = 1;
		let eye = { x: 0, y: 0, r: 8 }; // en coordenadas de documento
		let s1 = 1; // scroll en el que la bola aterriza en proyectos
		let s2 = 2; // scroll en el que el micelio empieza a recogerse
		let mSpan = 1;
		let qSpan = 1;
		let cx = 0;
		let hubY = 0;
		let ballR = 12;
		let pupils: { el: SVGCircleElement; cx: number; cy: number; ox: number; oy: number }[] = [];
		let portrait: SVGSVGElement | null = null;

		// ---------- micelio ----------
		type Branch = { pts: Float32Array; t0: number; depth: number; near: Float32Array };
		let branches: Branch[] = [];
		let tMax = 1;
		let nearMax = 1;
		let netW = 0;
		let netH = 0;

		type Hair = { a: number; len: number; bend: number; phase: number; curl: number };
		type Mota = { x: number; y: number; rx: number; ry: number; rot: number; hairs: Hair[]; phase: number };
		let motas: Mota[] = [];

		function buildNetwork() {
			const rand = rng(20261112);
			const top = -40;
			const bottom = vh * 1.2 + 40;
			const left = -40;
			const right = vw + 40;
			const cell = vw < 700 ? 14 : 16;
			const cols = Math.ceil((right - left) / cell) + 1;
			const rows = Math.ceil((bottom - top) / cell) + 1;
			const grid = new Int32Array(cols * rows).fill(-1);
			const step = 6.5;
			const maxPoints = vw < 700 ? 6000 : 13000;

			type Tip = { x: number; y: number; a: number; curve: number; depth: number; id: number; age: number; pts: number[]; t0: number };
			const done: Tip[] = [];
			let tips: Tip[] = [];
			let nextId = 0;
			const first = 9;
			for (let k = 0; k < first; k++) {
				tips.push({
					x: cx, y: hubY,
					a: (k / first) * Math.PI * 2 + (rand() - 0.5) * 0.5,
					curve: (rand() - 0.5) * 0.08,
					depth: 0, id: nextId++, age: 0, pts: [cx, hubY], t0: 0,
				});
			}

			let time = 0;
			let total = 0;
			while (tips.length && total < maxPoints) {
				time++;
				const next: Tip[] = [];
				for (const tip of tips) {
					tip.curve = clamp(tip.curve + (rand() - 0.5) * 0.03, -0.07, 0.07);
					tip.a += tip.curve + (rand() - 0.5) * 0.16;
					const nx = tip.x + Math.cos(tip.a) * step;
					const ny = tip.y + Math.sin(tip.a) * step;
					if (nx < left || nx > right || ny < top || ny > bottom) {
						done.push(tip);
						continue;
					}
					const gi = Math.floor((ny - top) / cell) * cols + Math.floor((nx - left) / cell);
					const owner = grid[gi];
					tip.x = nx;
					tip.y = ny;
					tip.pts.push(nx, ny);
					tip.age++;
					total++;
					if (owner !== -1 && owner !== tip.id && tip.age > 4) {
						done.push(tip); // se funde con otro hilo (anastomosis)
						continue;
					}
					if (owner === -1) grid[gi] = tip.id;
					next.push(tip);
					const chance = tip.depth === 0 ? 0.14 : tip.depth === 1 ? 0.11 : 0.08;
					if (tip.age > 3 && rand() < chance) {
						const side = rand() < 0.5 ? -1 : 1;
						next.push({
							x: nx, y: ny,
							a: tip.a + side * (0.35 + rand() * 0.6),
							curve: (rand() - 0.5) * 0.1,
							depth: tip.depth + 1, id: nextId++, age: 0, pts: [nx, ny], t0: time,
						});
					}
				}
				tips = next;
			}
			done.push(...tips);
			tMax = time;

			// Motas: puntos del micelio bien repartidos, lejos de la columna del formulario.
			const candidates: number[] = [];
			const column = vw > 900 ? 330 : 0;
			const limitY = vh * 1.2 - 70;
			for (const tip of done) {
				for (let i = 4; i < tip.pts.length; i += 12) {
					const x = tip.pts[i];
					const y = tip.pts[i + 1];
					if (x < 46 || x > vw - 46 || y < vh * 0.2 + 70 || y > limitY) continue;
					if (Math.abs(x - cx) < column) continue;
					candidates.push(x, y);
				}
			}
			const count = clamp(Math.round((vw * vh) / 95000), 5, 13);
			const centers: number[] = [];
			if (candidates.length) {
				let pick = Math.floor(rand() * (candidates.length / 2)) * 2;
				centers.push(candidates[pick], candidates[pick + 1]);
				while (centers.length / 2 < count) {
					let best = -1;
					let bestD = -1;
					for (let i = 0; i < candidates.length; i += 2) {
						let d = Infinity;
						for (let j = 0; j < centers.length; j += 2) {
							d = Math.min(d, Math.hypot(candidates[i] - centers[j], candidates[i + 1] - centers[j + 1]));
						}
						d *= 0.75 + rand() * 0.5; // reparto menos regular
						if (d > bestD) {
							bestD = d;
							best = i;
						}
					}
					if (best < 0) break;
					centers.push(candidates[best], candidates[best + 1]);
				}
			}

			motas = [];
			for (let i = 0; i < centers.length; i += 2) {
				const size = 0.75 + rand() * 0.6;
				const hairs: Hair[] = [];
				const n = 16 + Math.floor(rand() * 10);
				for (let k = 0; k < n; k++) {
					const long = rand() < 0.3;
					hairs.push({
						a: (k / n) * Math.PI * 2 + (rand() - 0.5) * 0.6,
						len: (long ? 34 + rand() * 30 : 14 + rand() * 22) * size,
						bend: (rand() - 0.5) * 1.5,
						phase: rand() * Math.PI * 2,
						curl: rand() < 0.3 ? (rand() < 0.5 ? -1 : 1) * (0.5 + rand() * 0.6) : 0,
					});
				}
				motas.push({
					x: centers[i], y: centers[i + 1],
					rx: 5 * size, ry: 7.6 * size,
					rot: (rand() - 0.5) * 1.2,
					hairs,
					phase: rand() * Math.PI * 2,
				});
			}

			nearMax = 1;
			branches = done.filter((tip) => tip.pts.length >= 4).map((tip) => {
				const pts = Float32Array.from(tip.pts);
				const near = new Float32Array(pts.length / 2);
				for (let i = 0; i < near.length; i++) {
					let d = Infinity;
					for (let j = 0; j < centers.length; j += 2) {
						d = Math.min(d, Math.hypot(pts[i * 2] - centers[j], pts[i * 2 + 1] - centers[j + 1]));
					}
					near[i] = d;
					if (d > nearMax && d < Infinity) nearMax = d;
				}
				return { pts, t0: tip.t0, depth: Math.min(2, tip.depth), near };
			});
			netW = vw;
			netH = vh;
		}

		function measure() {
			const newW = window.innerWidth;
			const newH = window.innerHeight;
			vw = newW;
			vh = newH;
			dpr = Math.min(2, window.devicePixelRatio || 1);
			for (const canvas of [back!, front!]) {
				const w = Math.floor(vw * dpr);
				const h = Math.floor(Math.max(vh, canvas.clientHeight) * dpr);
				if (canvas.width !== w || canvas.height !== h) {
					canvas.width = w;
					canvas.height = h;
				}
			}
			const sy = window.scrollY;
			ballR = vw < 700 ? 9.5 : 12.5;
			cx = vw / 2;
			hubY = vh * 0.5;

			const stage = document.getElementById('sketch-stage');
			if (stage) {
				const r = stage.getBoundingClientRect();
				const k = Math.min(r.width / art.w, r.height / art.h);
				eye = {
					x: r.left + (r.width - art.w * k) / 2 + art.eye[0] * k,
					y: r.top + sy + (r.height - art.h * k) / 2 + art.eye[1] * k,
					r: art.eye[2] * k,
				};
			} else {
				eye = { x: vw * 0.7, y: vh * 0.3, r: 8 };
			}

			const projects = document.getElementById('proyectos');
			const contact = document.getElementById('contacto');
			const maxScroll = Math.max(1, document.documentElement.scrollHeight - vh);
			const yp = projects ? projects.getBoundingClientRect().top + sy : maxScroll * 0.6;
			const yc = contact ? contact.getBoundingClientRect().top + sy : maxScroll * 0.9;
			s1 = Math.max(vh * 0.8, yp - vh * 0.36);
			s2 = Math.max(s1 + vh * 0.5, Math.min(yc - vh * 0.45, maxScroll - vh * 0.6));
			mSpan = Math.min(vh * 1.05, (s2 - s1) * 0.8);
			qSpan = Math.max(120, Math.min(vh * 0.75, maxScroll - 8 - s2));

			portrait = document.getElementById('portrait-sketch') as SVGSVGElement | null;
			if (portrait && !pupils.length) {
				pupils = Array.from(portrait.querySelectorAll<SVGCircleElement>('.portrait-pupil')).map((el) => ({
					el,
					cx: Number(el.getAttribute('cx')),
					cy: Number(el.getAttribute('cy')),
					ox: 0,
					oy: 0,
				}));
			}

			if (!branches.length || Math.abs(netW - vw) > 2 || Math.abs(netH - vh) > 130) buildNetwork();
			dirty = true;
		}

		// ---------- trayectoria de la bola (función pura del scroll) ----------
		function ballAt(s: number) {
			if (s >= s1) return { x: cx, y: hubY };
			const u = clamp(s / s1);
			const fall = easeInOut(clamp(s / (vh * 0.75)));
			const g = lerp(eye.y / vh, 0.5, fall);
			const env = smooth(0, 0.12, u) * (1 - smooth(0.84, 1, u));
			const amp = Math.min(vw * 0.36, 470);
			// deriva de algo que se hunde: un vaivén amplio y otro pequeño encima
			const meanderX = cx + amp * Math.sin(u * Math.PI * 2 * 2.25 + Math.PI) + vw * 0.03 * Math.sin(u * Math.PI * 2 * 6.3);
			const baseX = lerp(eye.x, cx, smooth(0, 1, u));
			const x = lerp(baseX, meanderX, env);
			const y = g * vh + Math.sin(u * Math.PI * 2 * 3.4) * vh * 0.055 * env;
			return { x, y };
		}

		// ---------- dibujo ----------
		let ss = window.scrollY; // scroll suavizado
		let last = performance.now();
		let start = last;
		let dirty = true;
		let prevBall = { x: 0, y: 0, r: 0 };
		let vel = { x: 0, y: 0 };
		let lastPos: { x: number; y: number } | null = null;
		let roll = 0;
		let backWasBusy = false;

		function blob(ctx: CanvasRenderingContext2D, r: number, time: number, wobble: number) {
			const n = 28;
			ctx.beginPath();
			for (let i = 0; i <= n; i++) {
				const a = (i / n) * Math.PI * 2;
				const k = 1 + wobble * (Math.sin(a * 3 + time * 2.1) * 0.6 + Math.sin(a * 5 - time * 3.3) * 0.4);
				const x = Math.cos(a) * r * k;
				const y = Math.sin(a) * r * k;
				if (i === 0) ctx.moveTo(x, y);
				else ctx.lineTo(x, y);
			}
			ctx.closePath();
		}

		function drawBall(ctx: CanvasRenderingContext2D, x: number, y: number, r: number, time: number, wobble: number, alpha = 1) {
			const speed = Math.hypot(vel.x, vel.y);
			const stretch = Math.min(0.32, speed * 0.012);
			ctx.save();
			ctx.translate(x, y);
			ctx.rotate(Math.atan2(vel.y, vel.x || 0.0001));
			ctx.scale(1 + stretch, 1 - stretch * 0.55);
			ctx.rotate(-Math.atan2(vel.y, vel.x || 0.0001));
			blob(ctx, r, time, wobble);
			ctx.fillStyle = `rgba(${GOLD}, ${alpha})`;
			ctx.fill();
			ctx.lineWidth = 1;
			ctx.strokeStyle = `rgba(${GOLD_DEEP}, ${0.55 * alpha})`;
			ctx.stroke();
			// brillo pequeño que rueda con la bola
			ctx.beginPath();
			ctx.ellipse(Math.cos(roll - 2.2) * r * 0.42, Math.sin(roll - 2.2) * r * 0.42, r * 0.24, r * 0.15, roll, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(${GOLD_LIGHT}, ${0.85 * alpha})`;
			ctx.fill();
			ctx.restore();
		}

		function drawFront(now: number, m: number) {
			const time = (now - start) / 1000;
			const pad = 6;
			fctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
			if (prevBall.r > 0) {
				const e = prevBall.r * 3.4 + pad;
				fctx!.clearRect(prevBall.x - e, prevBall.y - e, e * 2, e * 2);
				prevBall.r = 0;
			}
			if (m > 0) return null;

			const intro = reduceMotion ? 1 : clamp((now - start - INTRO_START) / INTRO_MS);
			const pos = reduceMotion ? { x: eye.x, y: eye.y - window.scrollY } : ballAt(ss);
			if (intro <= 0) return pos;

			const grow = intro < 1 ? Math.max(0, easeOutBack(intro)) : 1;
			const r = ballR * grow;
			const wobble = 0.035 + 0.3 * Math.pow(1 - intro, 1.5);
			if (intro < 1) {
				// gotas doradas que salen del anillo del ojo y se funden en la bola
				const beads = 6;
				for (let i = 0; i < beads; i++) {
					const a = (i / beads) * Math.PI * 2 + intro * 3.2 + i;
					const d = (eye.r * 1.9 + ballR) * Math.pow(1 - intro, 1.6) * (0.7 + 0.3 * Math.sin(i * 2.4));
					const br = ballR * 0.26 * Math.sin(Math.PI * Math.min(1, intro * 1.25));
					if (br <= 0.2) continue;
					fctx!.beginPath();
					fctx!.arc(pos.x + Math.cos(a) * d, pos.y + Math.sin(a) * d, br, 0, Math.PI * 2);
					fctx!.fillStyle = `rgba(${GOLD}, 0.95)`;
					fctx!.fill();
				}
			}
			drawBall(fctx!, pos.x, pos.y, r, time, wobble);
			prevBall = { x: pos.x, y: pos.y, r: Math.max(r, (eye.r * 1.9 + ballR) / 3) };
			return pos;
		}

		function drawBack(now: number, m: number, q: number) {
			const time = (now - start) / 1000;
			bctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
			bctx!.clearRect(0, 0, vw, back!.height / dpr);
			if (m <= 0) return;

			const par = clamp((ss - s1) / Math.max(1, s2 + qSpan - s1)) * vh * 0.2;
			const tNow = Math.pow(m, 0.85) * (tMax + 2);
			const gather = easeInOut(q);
			const reach = q > 0 ? (1 - gather) * nearMax * 1.02 : Infinity;

			bctx!.save();
			bctx!.translate(0, -par);
			bctx!.lineCap = 'round';
			bctx!.lineJoin = 'round';

			const widths = [1.9, 1.3, 0.9];
			const alphas = [0.9, 0.78, 0.62];
			const tipsX: number[] = [];
			const tipsY: number[] = [];
			for (let depth = 0; depth < 3; depth++) {
				bctx!.beginPath();
				for (const b of branches) {
					if (b.depth !== depth) continue;
					const shown = tNow - b.t0;
					if (shown <= 0) continue;
					const n = b.pts.length / 2;
					const whole = Math.min(n - 1, Math.floor(shown));
					const frac = shown - whole;
					let pen = false;
					for (let i = 0; i <= whole; i++) {
						if (b.near[i] > reach) {
							pen = false;
							continue;
						}
						if (!pen) {
							bctx!.moveTo(b.pts[i * 2], b.pts[i * 2 + 1]);
							pen = true;
						} else {
							bctx!.lineTo(b.pts[i * 2], b.pts[i * 2 + 1]);
						}
					}
					if (pen && whole < n - 1) {
						const x = lerp(b.pts[whole * 2], b.pts[whole * 2 + 2], frac);
						const y = lerp(b.pts[whole * 2 + 1], b.pts[whole * 2 + 3], frac);
						bctx!.lineTo(x, y);
						tipsX.push(x);
						tipsY.push(y);
					}
				}
				bctx!.lineWidth = widths[depth];
				bctx!.strokeStyle = `rgba(${GOLD}, ${alphas[depth]})`;
				bctx!.stroke();
			}

			// puntas vivas del micelio
			if (tipsX.length) {
				bctx!.fillStyle = `rgba(${GOLD}, 0.95)`;
				bctx!.beginPath();
				for (let i = 0; i < tipsX.length; i++) {
					bctx!.moveTo(tipsX[i] + 1.7, tipsY[i]);
					bctx!.arc(tipsX[i], tipsY[i], 1.7, 0, Math.PI * 2);
				}
				bctx!.fill();
			}

			// el núcleo: la bola, que se va gastando en hilos
			const hubR = ballR * lerp(1, 0.42, smooth(0, 0.35, m));
			const hubAlpha = 1 - smooth(0.15, 0.7, q);
			if (hubAlpha > 0.01) drawBall(bctx!, cx, hubY, hubR, time, 0.05, hubAlpha);

			// motas
			if (q > 0) {
				const body = clamp(q / 0.55);
				const hair = smooth(0.25, 1, q);
				for (const mota of motas) {
					const mx = mota.x + Math.sin(time * 0.35 + mota.phase) * 5 * gather;
					const my = mota.y + Math.cos(time * 0.28 + mota.phase * 1.7) * 6 * gather;
					const rot = mota.rot + Math.sin(time * 0.22 + mota.phase) * 0.25 * gather;
					bctx!.save();
					bctx!.translate(mx, my);
					bctx!.rotate(rot);
					if (hair > 0) {
						bctx!.beginPath();
						for (const h of mota.hairs) {
							const a = h.a + Math.sin(time * 0.9 + h.phase) * 0.13;
							const len = h.len * hair;
							const sx = Math.cos(a) * mota.rx * 0.6;
							const sy = Math.sin(a) * mota.ry * 0.6;
							const ex = sx + Math.cos(a) * len;
							const ey = sy + Math.sin(a) * len;
							const bend = h.bend + Math.sin(time * 0.7 + h.phase * 1.3) * 0.18;
							const mxp = (sx + ex) / 2 - Math.sin(a) * len * 0.35 * bend;
							const myp = (sy + ey) / 2 + Math.cos(a) * len * 0.35 * bend;
							bctx!.moveTo(sx, sy);
							if (h.curl) {
								// algunos pelos se rizan en la punta
								const ca = a + h.curl * 1.9;
								bctx!.bezierCurveTo(mxp, myp, ex + Math.cos(a) * len * 0.18, ey + Math.sin(a) * len * 0.18, ex + Math.cos(ca) * len * 0.22, ey + Math.sin(ca) * len * 0.22);
							} else {
								bctx!.quadraticCurveTo(mxp, myp, ex, ey);
							}
						}
						bctx!.lineWidth = 0.95;
						bctx!.strokeStyle = `rgba(${GOLD_DEEP}, 0.9)`;
						bctx!.stroke();
					}
					const k = Math.max(0, easeOutBack(body));
					bctx!.beginPath();
					bctx!.ellipse(0, 0, mota.rx * k, mota.ry * k, 0, 0, Math.PI * 2);
					bctx!.fillStyle = `rgba(${GOLD}, 1)`;
					bctx!.fill();
					bctx!.lineWidth = 1;
					bctx!.strokeStyle = `rgba(${GOLD_DEEP}, 0.8)`;
					bctx!.stroke();
					bctx!.restore();
				}
			}
			bctx!.restore();
		}

		function lookAt(target: { x: number; y: number } | null, dt: number) {
			if (!portrait || !pupils.length) return;
			const rect = portrait.getBoundingClientRect();
			if (rect.bottom < -200 || rect.top > vh + 200 || rect.width < 2) return;
			// viewBox 200×250 con «slice»: la escala es la mayor de las dos
			const k = Math.max(rect.width / 200, rect.height / 250);
			const ox = rect.left + (rect.width - 200 * k) / 2;
			const oy = rect.top + (rect.height - 250 * k) / 2;
			const ease = 1 - Math.exp(-dt * 10);
			for (const p of pupils) {
				let tx = 0;
				let ty = 0;
				if (target) {
					const dx = target.x - (ox + p.cx * k);
					const dy = target.y - (oy + p.cy * k);
					const d = Math.hypot(dx, dy) || 1;
					const reach = Math.min(1, d / 90);
					tx = (dx / d) * 4.6 * reach;
					ty = (dy / d) * 2.5 * reach;
				}
				p.ox += (tx - p.ox) * ease;
				p.oy += (ty - p.oy) * ease;
				p.el.setAttribute('transform', `translate(${p.ox.toFixed(2)} ${p.oy.toFixed(2)})`);
			}
		}

		function frame(now: number) {
			const dt = Math.min(0.05, (now - last) / 1000);
			last = now;
			const target = window.scrollY;
			const before = ss;
			ss += (target - ss) * (1 - Math.exp(-dt * 8));
			if (Math.abs(target - ss) < 0.1) ss = target;
			if (ss !== before) dirty = true;

			const m = reduceMotion ? 0 : clamp((ss - s1) / mSpan);
			const q = reduceMotion ? 0 : clamp((ss - s2) / qSpan);

			const pos = drawFront(now, m);
			const where = pos ?? { x: cx, y: hubY };
			if (lastPos && dt > 0) {
				const k = 1 - Math.exp(-dt * 12);
				// la velocidad propia de la bola, sin contar el desplazamiento de la página
				vel.x += ((where.x - lastPos.x) / (dt * 60) - vel.x) * k;
				vel.y += ((where.y - lastPos.y) / (dt * 60) - vel.y) * k;
				roll += (where.x - lastPos.x) / ballR;
			}
			lastPos = where;

			const busy = m > 0;
			if (busy ? dirty || q > 0 || (m < 1 && ss !== target) : backWasBusy) drawBack(now, m, q);
			backWasBusy = busy;
			dirty = false;

			lookAt(m < 1 ? where : null, dt);
			requestAnimationFrame(frame);
		}

		measure();
		let resizeTimer = 0;
		const remeasure = () => {
			clearTimeout(resizeTimer);
			resizeTimer = window.setTimeout(measure, 120);
		};
		window.addEventListener('resize', remeasure);
		window.addEventListener('load', measure);
		new ResizeObserver(remeasure).observe(document.body);
		document.fonts?.ready.then(measure);
		requestAnimationFrame((now) => {
			start = now;
			last = now;
			frame(now);
		});
	}
</script>
