---
// El cadavre exquis del hero: el dibujo a tinta se traza de arriba abajo
// y después respira un poco (línea que tiembla, pelo que ondea, gotas que caen).
// La bola dorada que nace del ojo la dibuja GoldenThread.
---

<div class="sketch-stage" id="sketch-stage">
	<canvas id="cadavre-canvas" aria-hidden="true"></canvas>
</div>

<style>
	.sketch-stage {
		position: absolute;
		inset: -7% -36% -7% -12%;
	}

	#cadavre-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	@media (max-width: 1040px) {
		.sketch-stage {
			inset: -4% -22% -4% -10%;
		}
	}

	@media (max-width: 760px) {
		.sketch-stage {
			inset: 0 -4%;
		}
	}
</style>

<style is:global>
	.hero {
		overflow-x: clip;
	}
</style>

<script>
	import art from '../data/cadavre.json';

	const stage = document.getElementById('sketch-stage');
	const canvas = document.getElementById('cadavre-canvas') as HTMLCanvasElement | null;
	const ctx = canvas?.getContext('2d') ?? null;

	if (stage && canvas && ctx) {
		const INK = '#161513';
		const BUILD_MS = 1900;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		type Line = {
			pts: Float32Array; // x0,y0,x1,y1…
			cum: Float32Array; // longitud acumulada por punto
			len: number;
			w: number;
			start: number;
			dur: number;
			drop: boolean;
			flow: boolean;
			seed: number;
		};

		const W = art.w;
		const H = art.h;
		const lines: Line[] = (art.paths as number[][]).map((raw, index) => {
			const n = (raw.length - 1) / 2;
			const pts = new Float32Array(n * 2);
			const cum = new Float32Array(n);
			let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
			for (let i = 0; i < n; i++) {
				const x = raw[1 + i * 2];
				const y = raw[2 + i * 2];
				pts[i * 2] = x;
				pts[i * 2 + 1] = y;
				if (i > 0) cum[i] = cum[i - 1] + Math.hypot(x - pts[i * 2 - 2], y - pts[i * 2 - 1]);
				minX = Math.min(minX, x); maxX = Math.max(maxX, x);
				minY = Math.min(minY, y); maxY = Math.max(maxY, y);
			}
			const len = cum[n - 1];
			const jitter = ((index * 7919) % 97) / 97;
			return {
				pts,
				cum,
				len,
				w: raw[0],
				start: (minY / H) * 0.7 + jitter * 0.05,
				dur: Math.max(0.04, Math.min(0.25, len / 900)),
				drop: minX > 684 && maxX < 732 && minY > 728 && maxY < 814,
				flow: minX > 850 && minY > 790,
				seed: index * 131,
			};
		});

		let width = 0;
		let height = 0;
		let scale = 1;
		let offX = 0;
		let offY = 0;
		let raf = 0;
		let t0 = 0;
		let visible = true;

		// Una vez trazado, casi todo el dibujo solo cambia cuando «hierve» la línea
		// (cada 150 ms): esa parte vive en su propio lienzo, debajo, y solo se
		// repinta entonces. En el de arriba quedan el pelo que ondea y las gotas,
		// lo único que se traza de verdad a 60 fps (y solo se borra su zona).
		const layer = document.createElement('canvas');
		layer.setAttribute('aria-hidden', 'true');
		layer.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;';
		canvas.style.position = 'relative';
		stage.insertBefore(layer, canvas);
		const lctx = layer.getContext('2d');
		let layerFrame = -1;
		let split = false; // ¿el lienzo de arriba ya solo lleva lo que se mueve?
		// zonas (en unidades del dibujo) donde viven el pelo y las gotas, con margen
		const LIVE = [
			[838, 768, W + 12, H + 22],
			[668, 692, 748, 852],
		];
		type Group = { lw: number; still: Line[]; flow: Line[]; all: Line[] };
		let groups: Group[] = [];
		const dropLines = lines.filter((line) => line.drop);

		function regroup() {
			const map = new Map<number, Group>();
			for (const line of lines) {
				const lw = Math.max(1, Math.round(line.w * scale * 0.82 * 2.5) / 2.5);
				let g = map.get(lw);
				if (!g) map.set(lw, (g = { lw, still: [], flow: [], all: [] }));
				g.all.push(line);
				if (line.drop) continue;
				(line.flow ? g.flow : g.still).push(line);
			}
			groups = Array.from(map.values());
		}

		function resize() {
			const rect = stage!.getBoundingClientRect();
			width = rect.width;
			height = rect.height;
			if (width < 2 || height < 2) return false;
			const dpr = Math.min(2, window.devicePixelRatio || 1);
			canvas!.width = Math.floor(width * dpr);
			canvas!.height = Math.floor(height * dpr);
			ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
			layer.width = canvas!.width;
			layer.height = canvas!.height;
			lctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
			layerFrame = -1;
			split = false;
			scale = Math.min(width / W, height / H);
			offX = (width - W * scale) / 2;
			offY = (height - H * scale) / 2;
			regroup();
			return true;
		}

		// Ruido barato y determinista para el temblor de la línea.
		function hash(n: number) {
			const s = Math.sin(n * 12.9898) * 43758.5453;
			return s - Math.floor(s) - 0.5;
		}

		function draw(now: number) {
			if (width < 2) return;
			const elapsed = now - t0;
			const build = reduceMotion ? 1 : Math.min(1, elapsed / BUILD_MS);
			const time = elapsed / 1000;
			const boilFrame = reduceMotion ? 0 : Math.floor(elapsed / 150);
			const boil = reduceMotion ? 0 : 0.55 / scale * Math.min(1, scale * 2.2);
			const alive = reduceMotion ? 0 : Math.max(0, Math.min(1, (elapsed - BUILD_MS) / 900));

			let pen = ctx!; // dónde traza `trace`
			const trace = (line: Line, dx: number, dy: number) => {
				const local = build >= 1 ? 1 : (build - line.start * 0.92) / line.dur;
				if (local <= 0) return;
				const n = line.pts.length / 2;
				const target = local >= 1 ? Infinity : line.len * local;
				for (let i = 0; i < n; i++) {
					let x = line.pts[i * 2];
					let y = line.pts[i * 2 + 1];
					if (i > 0 && line.cum[i] > target) {
						const prev = line.cum[i - 1];
						const f = (target - prev) / (line.cum[i] - prev || 1);
						x = line.pts[i * 2 - 2] + (x - line.pts[i * 2 - 2]) * f;
						y = line.pts[i * 2 - 1] + (y - line.pts[i * 2 - 1]) * f;
						i = n; // último punto
					}
					if (boil) {
						const k = line.seed + (i >= n ? n : i) * 3.7 + boilFrame * 17.3;
						x += hash(k) * boil;
						y += hash(k + 51.7) * boil;
					}
					if (line.flow && alive > 0) {
						const reach = Math.max(0, (x - 850) / 740);
						y += Math.sin(x * 0.011 - time * 1.5 + line.seed) * 7 * reach * alive;
					}
					const px = offX + (x + dx) * scale;
					const py = offY + (y + dy) * scale;
					if (i === 0) {
						pen.moveTo(px, py);
						if (n === 1 || line.len === 0) pen.lineTo(px + 0.01, py);
					} else {
						pen.lineTo(px, py);
					}
				}
			};
			const strokeAll = (pick: (g: Group) => Line[]) => {
				pen.lineCap = 'round';
				pen.lineJoin = 'round';
				pen.strokeStyle = INK;
				for (const g of groups) {
					const list = pick(g);
					if (!list.length) continue;
					pen.lineWidth = g.lw;
					pen.beginPath();
					for (const line of list) trace(line, 0, 0);
					pen.stroke();
				}
			};

			const cached = build >= 1 && !reduceMotion && !!lctx;
			if (!cached) {
				// mientras se traza (o sin animación): todo de una vez, como siempre
				ctx!.clearRect(0, 0, width, height);
				strokeAll((g) => g.all);
				return;
			}

			if (layerFrame !== boilFrame) {
				layerFrame = boilFrame;
				pen = lctx!;
				lctx!.clearRect(0, 0, width, height);
				strokeAll((g) => g.still);
				pen = ctx!;
			}
			if (!split) {
				split = true;
				ctx!.clearRect(0, 0, width, height);
			} else {
				for (const [x0, y0, x1, y1] of LIVE) {
					ctx!.clearRect(offX + x0 * scale - 2, offY + y0 * scale - 2, (x1 - x0) * scale + 4, (y1 - y0) * scale + 4);
				}
			}
			strokeAll((g) => g.flow);
			const drops = dropLines;

			// Las gotas caen hacia la boca, en bucle.
			if (drops.length) {
				ctx!.lineCap = 'round';
				ctx!.lineJoin = 'round';
				ctx!.strokeStyle = INK;
				for (let k = 0; k < drops.length; k++) {
					const line = drops[k];
					const u = (time / 1.9 + (line.pts[1] > 770 ? 0.5 : 0)) % 1;
					ctx!.globalAlpha = 1 - alive + alive * Math.sin(Math.PI * u);
					ctx!.lineWidth = Math.max(1, line.w * scale * 0.82);
					ctx!.beginPath();
					trace(line, 0, (u - 0.5) * 44 * alive);
					ctx!.stroke();
				}
				ctx!.globalAlpha = 1;
			}
		}

		function tick(now: number) {
			draw(now);
			if (visible && !reduceMotion) raf = requestAnimationFrame(tick);
		}

		const visibility = new IntersectionObserver((entries) => {
			const was = visible;
			visible = entries.some((entry) => entry.isIntersecting);
			if (visible && !was && !reduceMotion) {
				cancelAnimationFrame(raf);
				raf = requestAnimationFrame(tick);
			}
		}, { threshold: 0 });
		visibility.observe(stage);

		const resizeObserver = new ResizeObserver(() => {
			if (resize()) draw(performance.now());
		});
		resizeObserver.observe(stage);

		requestAnimationFrame((now) => {
			t0 = now;
			resize();
			tick(now);
		});
	}
</script>
