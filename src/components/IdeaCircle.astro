</script>

<style is:global>
	.hero-title-accent {
		position: relative;
		display: inline-block;
	}

	.idea-circle {
		position: absolute;
		left: -0.22em;
		width: calc(100% + 0.5em);
		top: -0.16em;
		height: 1.26em;
		overflow: visible;
		pointer-events: none;
	}

	.idea-circle path {
		fill: none;
		stroke: #161513;
		stroke-width: 1.7px;
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
		stroke-dasharray: 480;
		stroke-dashoffset: 480;
		animation: idea-circle-draw 1.9s ease-out forwards;
	}

	@keyframes idea-circle-draw {
		to {
			stroke-dashoffset: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.idea-circle path {
			animation: none;
			stroke-dashoffset: 0;
		}
	}
</style>
