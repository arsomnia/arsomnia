---
// Dibujo temporal: un círculo a mano, en un solo gesto.
// Dos vueltas que no coinciden. Sin borrado.
---

<div class="sketch-stage" id="sketch-stage">
	<canvas id="structure-canvas" aria-hidden="true"></canvas>
</div>

<style>
	.sketch-stage {
		position: absolute;
		inset: 0;
	}

	#structure-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	const stage = document.getElementById('sketch-stage');
	const canvas = document.getElementById('structure-canvas') as HTMLCanvasElement | null;
	const ctx = canvas?.getContext('2d') ?? null;

	if (stage && canvas && ctx) {
		type Pt = { x: number; y: number };
		type Stroke = {
			pts: Pt[];
			width: number;
			alpha: number;
			start: number;
			end: number;
		};

		const INK = '27, 24, 21';
		const BUILD_MS = 2000;
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		let width = 0;
		let height = 0;
		let progress = 0;
		let animationId = 0;
		let buildStart = 0;
		let isVisible = true;
		let resting = false;

		// Un solo trazo: la mano da dos vueltas y la segunda no cae sobre la primera.
		function handCircle(): Pt[] {
			const turns = 2.79;
			const steps = 420;
			const presets = [
				{ r: 0, x: 0, y: 0 },
				{ r: 0.026, x: 0.009, y: 0.004 },
				{ r: 0.012, x: -0.008, y: 0.01 },
			];
			const pts: Pt[] = [];
			for (let i = 0; i <= steps; i++) {
				const u = i / steps;
				const angle = -Math.PI * 0.55 + u * turns * Math.PI * 2;
				const pass = u * turns;
				const lap = Math.min(presets.length - 1, Math.floor(pass));
				const blend = lap >= presets.length - 1 ? 0 : Math.min(1, (pass - lap) / 0.2);
				const from = presets[lap];
				const to = presets[Math.min(presets.length - 1, lap + 1)];
				const miss = from.r + (to.r - from.r) * blend;
				const ox = from.x + (to.x - from.x) * blend;
				const oy = from.y + (to.y - from.y) * blend;
				const wobble =
					Math.sin(angle * 2 + 0.4) * 0.009 +
					Math.cos(angle * 3 + pass * 0.35) * 0.005;
				const radius = 0.3 + wobble + miss;
				pts.push({
					x: ox + Math.cos(angle) * radius,
					y: oy + Math.sin(angle) * radius,
				});
			}
			return pts;
		}

		const strokes: Stroke[] = [
			{ pts: handCircle(), width: 5.2, alpha: 0.92, start: 0, end: 1 },
		];

		function resize() {
			const rect = stage.getBoundingClientRect();
			width = rect.width;
			height = rect.height;
			if (width < 2 || height < 2) return false;
			const dpr = Math.min(2, window.devicePixelRatio || 1);
			canvas.width = Math.floor(width * dpr);
			canvas.height = Math.floor(height * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			return true;
		}

		function sliceTo(pts: Pt[], t: number): Pt[] {
			if (t >= 1) return pts;
			if (t <= 0 || pts.length < 2) return [];
			let total = 0;
			const seg: number[] = [];
			for (let i = 1; i < pts.length; i++) {
				const d = Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y);
				seg.push(d);
				total += d;
			}
			const target = total * t;
			const out: Pt[] = [pts[0]];
			let acc = 0;
			for (let i = 1; i < pts.length; i++) {
				const d = seg[i - 1];
				if (acc + d >= target) {
					const f = d === 0 ? 1 : (target - acc) / d;
					out.push({
						x: pts[i - 1].x + (pts[i].x - pts[i - 1].x) * f,
						y: pts[i - 1].y + (pts[i].y - pts[i - 1].y) * f,
					});
					break;
				}
				out.push(pts[i]);
				acc += d;
			}
			return out;
		}

		function draw(amount: number) {
			if (width < 2 || height < 2) return;
			ctx.clearRect(0, 0, width, height);
			ctx.lineCap = 'round';
			ctx.lineJoin = 'round';
			const unit = Math.min(width, height);
			const cx = width * 0.5;
			const cy = height * 0.5;
			const scale = Math.max(1.05, Math.min(unit / 420, 1.8));

			for (const stroke of strokes) {
				const span = stroke.end - stroke.start;
				const local = Math.max(0, Math.min(1, (amount - stroke.start) / span));
				if (local <= 0) continue;
				const partial = sliceTo(stroke.pts, local);
				if (partial.length < 2) continue;
				const mapped = partial.map((p) => ({
					x: cx + p.x * unit,
					y: cy + p.y * unit,
				}));
				ctx.beginPath();
				ctx.moveTo(mapped[0].x, mapped[0].y);
				for (let i = 1; i < mapped.length; i++) ctx.lineTo(mapped[i].x, mapped[i].y);
				ctx.strokeStyle = `rgba(${INK}, ${stroke.alpha})`;
				ctx.lineWidth = stroke.width * scale;
				ctx.stroke();
			}
		}

		function tick(now: number) {
			if (width < 2) resize();
			progress = Math.min(1, (now - buildStart) / BUILD_MS);
			draw(progress);
			if (progress >= 1) {
				resting = true;
				return;
			}
			if (isVisible) animationId = requestAnimationFrame(tick);
		}

		function start() {
			cancelAnimationFrame(animationId);
			buildStart = performance.now() - progress * BUILD_MS;
			animationId = requestAnimationFrame(tick);
		}

		const visibility = new IntersectionObserver((entries) => {
			const was = isVisible;
			isVisible = entries.some((entry) => entry.isIntersecting);
			if (isVisible && !was && !resting) start();
			if (!isVisible && animationId) cancelAnimationFrame(animationId);
		}, { threshold: 0.05 });
		visibility.observe(stage);

		const resizeObserver = new ResizeObserver(() => {
			if (resize()) draw(progress);
		});
		resizeObserver.observe(stage);

		if (reduceMotion) {
			progress = 1;
			resting = true;
		}
		requestAnimationFrame(() => {
			resize();
			draw(progress);
			if (!reduceMotion) start();
		});

		document.addEventListener('astro:before-swap', () => {
			visibility.disconnect();
			resizeObserver.disconnect();
			cancelAnimationFrame(animationId);
		});
	}
</script>
