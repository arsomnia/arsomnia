<svg class="portrait-sketch" id="portrait-sketch" viewBox="0 0 200 250" preserveAspectRatio="xMidYMid slice" role="img" aria-label={label}>
	<path class="portrait-line" d={d} pathLength="1"></path>
	<circle class="portrait-pupil" cx="78" cy="106" r="2.7"></circle>
	<circle class="portrait-pupil" cx="123" cy="106" r="2.7"></circle>
</svg>

<script>
	const sketch = document.getElementById('portrait-sketch');
	if (sketch) {
		const reveal = () => sketch.classList.add('is-drawn');
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
			reveal();
		} else {
			const io = new IntersectionObserver((entries) => {
				if (entries.some((e) => e.isIntersecting)) {
					reveal();
					io.disconnect();
				}
			}, { threshold: 0.35 });
			io.observe(sketch);
		}
	}
</script>

<style is:global>
	figure.about-portrait:has(.portrait-sketch) {
		width: 232px;
		height: 286px;
	}

	.portrait-sketch {
		display: block;
		width: 100%;
		height: 100%;
	}

	.portrait-line {
		fill: none;
		stroke: var(--color-text);
		stroke-width: 1.35;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		transition: stroke-dashoffset 2.6s cubic-bezier(0.45, 0.05, 0.3, 1);
	}

	.portrait-pupil {
		fill: var(--color-text);
		opacity: 0;
		transition: opacity 0.4s ease 1.1s;
	}

	.portrait-sketch.is-drawn .portrait-line {
		stroke-dashoffset: 0;
	}

	.portrait-sketch.is-drawn .portrait-pupil {
		opacity: 1;
	}

	@media (max-width: 760px) {
		figure.about-portrait:has(.portrait-sketch) {
			width: 190px;
			height: 234px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.portrait-line,
		.portrait-pupil {
			transition: none;
		}
	}
</style>
